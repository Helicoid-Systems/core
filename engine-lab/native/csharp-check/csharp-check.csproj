<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>csharp-lifetime-check</AssemblyName>
    <RootNamespace>Helicoid.EngineLab.Check</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <!-- Frozen generated-contract wrappers. Never forked or hand-edited here. -->
    <Compile Include="..\wrappers\HsNativeWrapper.cs" Link="HsNativeWrapper.cs" />
    <Compile Include="..\wrappers\csharp_lifetime_check.cs" Link="csharp_lifetime_check.cs" />
    <!-- Own DLL search-path gate: loads the real built DLL only. -->
    <Compile Include="NativeDllGate.cs" />
  </ItemGroup>
</Project>
