+//! HS native bridge seam (RD02 laboratory).
+//!
+//! This module is the smallest viable internal seam for a UI-independent
+//! engine **construction** proof and **frame-lifetime** machinery. It is
+//! **not** a media, grant, input, or control API and it is **not** a wrapper
+//! around the RustDesk application.
+//!
+//! What this module actually owns: a real
+//! [`crate::ui_session_interface::Session`]`<`[`NativeHandler`]`>`, constructed
+//! inertly and dropped explicitly. [`NativeHandler`] is a real
+//! [`InvokeUiSession`] implementation. Frame pixels arriving at
+//! [`InvokeUiSession::on_rgba`] are copied into an owned immutable
+//! [`OwnedFrame`] with checked geometry; no borrowed mutable upstream pointer
+//! escapes. `get_rgba` returns null.
+//!
+//! State after construction is named **Prepared** and means *inert*. It does
+//! **not** mean admitted, connected, or ready-to-view. Connecting and
+//! observation exports return [`HS_STATUS_UNAVAILABLE`] before B03.
+//!
+//! Explicit non-claims and hard limits:
+//!
+//! - This is **not** remote initialization and **not** live media. The frame
+//!   path is RD02 lifetime machinery only; B03 admission does not exist.
+//! - [`hs_viewer_prepare`] never calls `Session::initialize`, `io_loop`,
+//!   `connect`, `start`, `core_main`, `start_server`, or any keyboard grab.
+//! - No Sciter/Flutter runtime is invoked. The upstream crate still compiles
+//!   those modules in the default feature set; this seam does not call them.
+//! - No config persistence: [`LoginConfigHandler::inert_default`] builds every
+//!   field in memory and does **not** read `UserDefaultConfig` / disk.
+//! - [`std::panic::catch_unwind`] contains Rust panics only. It does **not**
+//!   catch undefined behaviour. Callers must pass live pointers from
+//!   [`hs_engine_ctx_new`], must not use a pointer after free, and must not
+//!   re-enter these functions on the same context while one call is active.
+//! - Server keyboard / file-transfer / clipboard capabilities stay disabled
+//!   until a real authority bridge exists. No input/file/clipboard ABI.
+//! - B03 is not passed. This ABI is not an authorization surface.
+//! - The selected OSS relay adoption gate is **FAILED** (see lab report):
+//!   stock global `licence_key`/UUID pairing does not establish Helicoid
+//!   per-allocation authority. Media/control enablement is stopped.
+//!
+//! # Frame ownership contract
+//!
+//! - [`OwnedFrame`] holds an immutable pixel buffer copied from
+//!   [`ImageRgb`] at [`NativeHandler::on_rgba`] time. The copy uses the Rust
+//!   allocator; release is only through [`hs_frame_release`] (same allocator).
+//!   Never `free()` a frame from C.
+//! - Geometry is checked together: width, height, format, stride, and byte
+//!   length must agree under checked arithmetic before any copy.
+//! - A bounded latest-frame slot per display retains at most one live frame.
+//!   A newer frame disposes the superseded slot (late-frame disposal). The
+//!   disposed frame stays valid until every outstanding handle is released.
+//! - Each accepted frame carries the viewer generation and a monotonic
+//!   sequence. Frames whose generation does not match the live viewer fence
+//!   are disposed without publication.
+//! - Outstanding frame handles remain valid after observation close until
+//!   released; close never frees pixels still referenced by a handle.
+//!
+//! # Lifecycle callback contract
+//!
+//! Callbacks registered through [`hs_viewer_set_lifecycle_cb`] are invoked on
+//! an **internal bounded delivery worker**, never on the caller's thread and
+//! never assumed to be a UI thread. Rules:
+//!
+//! 1. Delivery is bounded and ordered per context; overflow drops the event
+//!    and increments the refused/dropped counter (no unbounded queue).
+//! 2. The callback may observe `user` only for the duration of the call.
+//!    Do not free `user` from inside the callback; free after
+//!    [`hs_viewer_drain`] returns.
+//! 3. `hs_viewer_request_close` from inside a callback is permitted and does
+//!    not deadlock: close only sets cancellation state and wakes the worker.
+//!    Context memory is not freed until bounded drain completes.
+//! 4. No borrowed mutable upstream pointer is passed to the callback. Frame
+//!    pixels are only reachable through an owned [`HsFrame`] handle.
+//!
+//! # Asynchronous cancellation and drain
+//!
+//! [`hs_viewer_request_close`] is non-blocking: it fences the generation,
+//! stops new publications, and requests worker cancellation. Outstanding
+//! callback work is collected by [`hs_viewer_drain`] under a millisecond
+//! deadline. [`hs_engine_ctx_free`] after un-drained work is refused
+//! ([`HS_STATUS_STATE`]); free is legal only once drain has completed (or
+//! never started async work).
+
+use std::collections::VecDeque;
+use std::ffi::CString;
+use std::os::raw::{c_char, c_void};
+use std::panic::{catch_unwind, AssertUnwindSafe};
+use std::sync::atomic::{AtomicBool, AtomicU32, AtomicU64, Ordering};
+use std::sync::{Arc, Condvar, Mutex, MutexGuard, OnceLock, RwLock};
+use std::time::{Duration, Instant};
+
+use base::message_proto::{
+    CursorData, CursorPosition, DisplayInfo, FileEntry, PeerInfo, SwitchDisplay, TerminalResponse,
+    WindowsSession,
+};
+use hbb_common::rendezvous_proto::ConnType;
+use scrap::{ImageFormat, ImageRgb};
+
+use crate::client::{LoginConfigHandler, QualityStatus};
+use crate::ui_session_interface::{
+    ChangeDisplayRecord, ConnectionRoundState, InvokeUiSession, Session,
+};
+
+/// ABI version for the C header. Bump on any semantic or layout change.
+/// v2: `hs_frame_desc` gained distinct layout/interaction admission fences.
+pub const HS_ABI_VERSION: u32 = 2;
+
+/// Maximum accepted peer-id length in bytes (matches hs-core `MAX_ID_BYTES`).
+pub const HS_MAX_PEER_ID_BYTES: usize = 128;
+
+/// Hard ceiling on a single frame dimension (width or height).
+pub const HS_MAX_FRAME_DIM: u32 = 16384;
+
+/// Hard ceiling on an owned frame payload in bytes (64 MiB).
+pub const HS_MAX_FRAME_BYTES: u32 = 67108864;
+
+/// Hard ceiling on simultaneously retained latest-frame slots (displays).
+pub const HS_MAX_FRAME_SLOTS: usize = 16;
+
+/// Hard ceiling on queued lifecycle events per context.
+pub const HS_MAX_LIFE_QUEUE: usize = 32;
+
+/// Hard ceiling on retired lifecycle-callback registrations kept across
+/// replacements. Native code cannot root foreign runtime objects; this bound
+/// exists so a caller cannot accumulate unbounded `(cb, user)` pairs.
+pub const HS_MAX_LIFE_RETIRED: usize = 8;
+
+/// Hard ceiling on a single admission fence value (layout / interaction).
+pub const HS_MAX_FENCE_GEN: u32 = 1073741823;
+
+/// Success.
+pub const HS_STATUS_OK: u32 = 0;
+/// Invalid argument (null, out of bounds, illegal characters).
+pub const HS_STATUS_INVALID: u32 = 1;
+/// Null pointer where a value is required.
+pub const HS_STATUS_NULL: u32 = 2;
+/// Operation is not valid in the current context state.
+pub const HS_STATUS_STATE: u32 = 3;
+/// A Rust panic occurred and was contained at the ABI boundary.
+pub const HS_STATUS_PANIC: u32 = 4;
+/// Context generation exhausted / already closed for new work.
+pub const HS_STATUS_EXHAUSTED: u32 = 5;
+/// Requested capability is not available before B03 (connecting/observation).
+pub const HS_STATUS_UNAVAILABLE: u32 = 6;
+/// Internal invariant failed (e.g. poisoned lock). Fail closed; do not proceed.
+pub const HS_STATUS_INTERNAL: u32 = 7;
+/// Frame geometry / payload failed checked bounds validation.
+pub const HS_STATUS_BOUNDS: u32 = 8;
+/// Bounded drain deadline expired before outstanding work finished.
+pub const HS_STATUS_TIMEOUT: u32 = 9;
+/// Channel binding / handshake prerequisite failed closed.
+pub const HS_STATUS_HANDSHAKE: u32 = 10;
+
+/// Pixel format codes for [`HsFrameDesc`].
+pub const HS_FRAME_FMT_RAW: u32 = 0;
+pub const HS_FRAME_FMT_ABGR: u32 = 1;
+pub const HS_FRAME_FMT_ARGB: u32 = 2;
+
+/// Lifecycle event codes delivered to the registered callback.
+pub const HS_LIFE_FRAME_READY: u32 = 1;
+pub const HS_LIFE_CLOSING: u32 = 2;
+pub const HS_LIFE_DRAINED: u32 = 3;
+
+/// Context lifecycle state.
+///
+/// `Prepared` means a real [`Session`]`<`[`NativeHandler`]`>` is owned and
+/// **inert**. It does **not** mean admitted, connected, or ready-to-view.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+#[repr(u32)]
+pub enum SessionState {
+    /// Context allocated; Session not yet constructed.
+    Created = 0,
+    /// Real inert `Session<NativeHandler>` constructed and owned.
+    /// Not admitted. Not ready-to-view. No media, no connection.
+    Prepared = 1,
+    /// Close requested; Session dropped; async drain may still run.
+    Closing = 2,
+    /// Drained and closed. No further work.
+    Closed = 3,
+}
+
+/// Owned immutable RGBA frame payload.
+///
+/// Pixels are copied out of [`ImageRgb`] at acceptance time. The buffer is
+/// released only by dropping the last [`Arc`] (via [`hs_frame_release`]).
+/// No borrowed upstream pointer is retained.
+pub struct OwnedFrame {
+    pixels: Arc<[u8]>,
+    desc: FrameDesc,
+}
+
+/// Validated frame descriptor (internal).
+///
+/// `viewer_generation` is the **context cancellation** fence (bumped by
+/// [`hs_viewer_request_close`]). It is intentionally separate from the two
+/// **frame-admission** fences below.
+///
+/// `layout_generation` and `interaction_generation` are distinct nonzero
+/// bounded fences that must come from a sealed admitted context. They are
+/// never taken from a caller-supplied token. The production HS endpoint
+/// admission adapter is unavailable in this lab; lifetime proofs use a
+/// cfg(test)-only fixture seal.
+#[derive(Debug, Clone, Copy)]
+pub struct FrameDesc {
+    pub width: u32,
+    pub height: u32,
+    pub stride: u32,
+    pub format: u32,
+    pub length: u32,
+    pub display: u32,
+    /// Context cancellation fence. Separate from admission fences.
+    pub viewer_generation: u32,
+    /// Frame-admission fence: display/layout revision. Nonzero, bounded.
+    pub layout_generation: u32,
+    /// Frame-admission fence: interaction generation. Nonzero, bounded.
+    pub interaction_generation: u32,
+    pub sequence: u64,
+}
+
+/// C-visible frame descriptor. Copied out by value; layout is stable.
+///
+/// Wrappers must consume this exact generated descriptor. Never guess a
+/// layout.
+#[repr(C)]
+#[derive(Debug, Clone, Copy)]
+pub struct HsFrameDesc {
+    pub width: u32,
+    pub height: u32,
+    pub stride: u32,
+    pub format: u32,
+    pub length: u32,
+    pub display: u32,
+    /// Context cancellation fence (see [`hs_viewer_request_close`]).
+    pub viewer_generation: u32,
+    /// Frame-admission fence: layout revision. Nonzero and bounded on admit.
+    pub layout_generation: u32,
+    /// Frame-admission fence: interaction generation. Nonzero and bounded.
+    pub interaction_generation: u32,
+    pub sequence: u64,
+}
+
+impl From<FrameDesc> for HsFrameDesc {
+    fn from(d: FrameDesc) -> Self {
+        Self {
+            width: d.width,
+            height: d.height,
+            stride: d.stride,
+            format: d.format,
+            length: d.length,
+            display: d.display,
+            viewer_generation: d.viewer_generation,
+            layout_generation: d.layout_generation,
+            interaction_generation: d.interaction_generation,
+            sequence: d.sequence,
+        }
+    }
+}
+
+/// Nonzero bounded frame-admission fences.
+///
+/// Sourced **only** from a sealed admitted context. The production HS
+/// endpoint admission adapter is not wired in this lab, so production
+/// construction cannot produce these fences. Lifetime proofs use
+/// [`AdmissionFences::fixture_seal`] under cfg(test).
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct AdmissionFences {
+    pub layout_generation: u32,
+    pub interaction_generation: u32,
+}
+
+/// Reject a zero or out-of-range admission fence. Both fences are checked
+/// independently.
+pub fn validate_admission_fence(name_is_layout: bool, value: u32) -> Result<(), u32> {
+    let _ = name_is_layout;
+    if value == 0 || value > HS_MAX_FENCE_GEN {
+        return Err(HS_STATUS_BOUNDS);
+    }
+    Ok(())
+}
+
+impl AdmissionFences {
+    /// Validate both fences independently (nonzero, bounded).
+    pub fn new(layout_generation: u32, interaction_generation: u32) -> Result<Self, u32> {
+        validate_admission_fence(true, layout_generation)?;
+        validate_admission_fence(false, interaction_generation)?;
+        Ok(Self {
+            layout_generation,
+            interaction_generation,
+        })
+    }
+
+    /// cfg(test)-only fixture seal. NOT a production media grant.
+    /// Every call site must be labelled a fixture lifetime check.
+    #[cfg(test)]
+    pub fn fixture_seal(layout_generation: u32, interaction_generation: u32) -> Result<Self, u32> {
+        Self::new(layout_generation, interaction_generation)
+    }
+}
+
+/// Opaque owned frame handle. Release with [`hs_frame_release`].
+pub struct HsFrame {
+    inner: Arc<OwnedFrame>,
+}
+
+impl HsFrame {
+    fn desc(&self) -> &FrameDesc {
+        &self.inner.desc
+    }
+
+    fn pixels(&self) -> &[u8] {
+        &self.inner.pixels
+    }
+}
+
+/// Compute bytes-per-row the same way scrap does, with checked arithmetic.
+fn checked_stride(width: u32, format: u32, align: u32) -> Result<u32, u32> {
+    if width == 0 || width > HS_MAX_FRAME_DIM {
+        return Err(HS_STATUS_BOUNDS);
+    }
+    if align == 0 || !align.is_power_of_two() {
+        return Err(HS_STATUS_BOUNDS);
+    }
+    let bpp = match format {
+        HS_FRAME_FMT_RAW => 3u32,
+        HS_FRAME_FMT_ARGB | HS_FRAME_FMT_ABGR => 4u32,
+        _ => return Err(HS_STATUS_BOUNDS),
+    };
+    let row = width
+        .checked_mul(bpp)
+        .ok_or(HS_STATUS_BOUNDS)?
+        .checked_add(align - 1)
+        .ok_or(HS_STATUS_BOUNDS)?
+        & !(align - 1);
+    if row == 0 || row > HS_MAX_FRAME_BYTES {
+        return Err(HS_STATUS_BOUNDS);
+    }
+    Ok(row)
+}
+
+/// Validate full frame geometry and payload length together.
+pub fn validate_frame_geometry(
+    width: u32,
+    height: u32,
+    format: u32,
+    align: u32,
+    payload_len: u32,
+) -> Result<u32, u32> {
+    if height == 0 || height > HS_MAX_FRAME_DIM {
+        return Err(HS_STATUS_BOUNDS);
+    }
+    let stride = checked_stride(width, format, align)?;
+    let expected = stride.checked_mul(height).ok_or(HS_STATUS_BOUNDS)?;
+    if expected == 0 || expected > HS_MAX_FRAME_BYTES {
+        return Err(HS_STATUS_BOUNDS);
+    }
+    if payload_len != expected {
+        return Err(HS_STATUS_BOUNDS);
+    }
+    Ok(stride)
+}
+
+fn format_code(fmt: ImageFormat) -> u32 {
+    match fmt {
+        ImageFormat::Raw => HS_FRAME_FMT_RAW,
+        ImageFormat::ABGR => HS_FRAME_FMT_ABGR,
+        ImageFormat::ARGB => HS_FRAME_FMT_ARGB,
+    }
+}
+
+/// Build an owned frame from a real [`ImageRgb`] with full bounds checking.
+///
+/// `fences` must already be validated ([`AdmissionFences::new`]). The
+/// resulting descriptor carries both admission fences and the separate
+/// viewer/context cancellation generation.
+pub fn owned_frame_from_image(
+    display: u32,
+    viewer_generation: u32,
+    fences: AdmissionFences,
+    sequence: u64,
+    img: &ImageRgb,
+) -> Result<OwnedFrame, u32> {
+    let format = format_code(img.fmt);
+    let align = u32::try_from(img.align).map_err(|_| HS_STATUS_BOUNDS)?;
+    let width = u32::try_from(img.w).map_err(|_| HS_STATUS_BOUNDS)?;
+    let height = u32::try_from(img.h).map_err(|_| HS_STATUS_BOUNDS)?;
+    let payload_len = u32::try_from(img.raw.len()).map_err(|_| HS_STATUS_BOUNDS)?;
+    let stride = validate_frame_geometry(width, height, format, align, payload_len)?;
+    // Copy; never retain the upstream buffer. Exact length already validated.
+    let pixels: Arc<[u8]> = Arc::from(img.raw.as_slice());
+    Ok(OwnedFrame {
+        pixels,
+        desc: FrameDesc {
+            width,
+            height,
+            stride,
+            format,
+            length: payload_len,
+            display,
+            viewer_generation,
+            layout_generation: fences.layout_generation,
+            interaction_generation: fences.interaction_generation,
+            sequence,
+        },
+    })
+}
+
+/// Bounded latest-frame store. At most [`HS_MAX_FRAME_SLOTS`] displays, each
+/// holding at most one published frame. Superseded frames are disposed from
+/// the slot immediately (late-frame disposal) but stay alive while handles
+/// exist.
+#[derive(Default)]
+struct FrameStore {
+    slots: Mutex<Vec<(u32, Arc<OwnedFrame>)>>,
+    sequence: AtomicU64,
+    disposed: AtomicU64,
+    published: AtomicU64,
+}
+
+impl FrameStore {
+    fn publish(&self, frame: Arc<OwnedFrame>) {
+        let mut slots = match self.slots.lock() {
+            Ok(s) => s,
+            Err(_) => return,
+        };
+        if let Some(pos) = slots.iter().position(|(d, _)| *d == frame.desc.display) {
+            // Supersede: dispose the previous slot entry.
+            let (_, old) = slots.remove(pos);
+            drop(old);
+            self.disposed.fetch_add(1, Ordering::Relaxed);
+        } else if slots.len() >= HS_MAX_FRAME_SLOTS {
+            // Bound: drop the oldest slot rather than grow without limit.
+            let (_, old) = slots.remove(0);
+            drop(old);
+            self.disposed.fetch_add(1, Ordering::Relaxed);
+        }
+        slots.push((frame.desc.display, frame));
+        self.published.fetch_add(1, Ordering::Relaxed);
+    }
+
+    fn latest(&self, display: u32) -> Option<Arc<OwnedFrame>> {
+        let slots = self.slots.lock().ok()?;
+        slots
+            .iter()
+            .find(|(d, _)| *d == display)
+            .map(|(_, f)| Arc::clone(f))
+    }
+
+    fn clear(&self) {
+        if let Ok(mut slots) = self.slots.lock() {
+            let n = slots.len() as u64;
+            slots.clear();
+            self.disposed.fetch_add(n, Ordering::Relaxed);
+        }
+    }
+
+    fn next_sequence(&self) -> u64 {
+        self.sequence.fetch_add(1, Ordering::Relaxed) + 1
+    }
+}
+
+/// Lifecycle event queued for the delivery worker.
+#[derive(Debug, Clone, Copy)]
+struct LifeEvent {
+    code: u32,
+    generation: u32,
+}
+
+type LifeCb = Option<extern "C" fn(*mut c_void, u32, u32)>;
+
+/// Opaque caller `user` pointer. The C caller owns the pointee and must keep
+/// it valid until drain completes. Send/Sync is asserted for the pointer only;
+/// the pointee is only touched inside the registered callback on the delivery
+/// worker.
+#[derive(Clone, Copy)]
+struct UserPtr(*mut c_void);
+
+// SAFETY: the raw pointer is only dereferenced inside the caller-supplied
+// callback, which the caller documents as single-threaded on the delivery
+// worker. The pointer itself is just an address carried across threads.
+unsafe impl Send for UserPtr {}
+unsafe impl Sync for UserPtr {}
+
+/// Internal delivery worker state.
+///
+/// The queue is bounded. Events are delivered by a dedicated worker thread
+/// that never holds [`LifeQueue`] while invoking the callback, so a callback
+/// may call [`hs_viewer_request_close`] without deadlocking.
+///
+/// `retired` records prior `(cb, user)` pairs across replacement so an
+/// in-flight callback is not forgotten. **Native code does not own and cannot
+/// root foreign runtime objects** (GC handles, Swift refcounts). The caller
+/// must keep its own userdata alive until drain proves the worker quiescent.
+/// This list is only a bounded record, not a lifetime guarantee.
+struct LifeQueue {
+    q: VecDeque<LifeEvent>,
+    /// Active callback. Replacement pushes the previous pair into `retired`.
+    cb: LifeCb,
+    user: UserPtr,
+    /// Bounded record of prior registrations. Not a foreign-root owner.
+    retired: Vec<(LifeCb, UserPtr)>,
+    cancelled: bool,
+    dropped: u32,
+    /// Callback currently executing.
+    inflight: bool,
+    /// Worker has exited.
+    worker_done: bool,
+}
+
+impl LifeQueue {
+    /// Outstanding callback-delivery work only.
+    ///
+    /// Events retained for polling (`cb == None`) are not delivery work and
+    /// must not keep drain from reporting quiescence or the worker from
+    /// exiting. In-flight delivery always counts.
+    fn pending(&self) -> usize {
+        if self.cb.is_none() {
+            return usize::from(self.inflight);
+        }
+        self.q.len() + usize::from(self.inflight)
+    }
+}
+
+/// Real [`InvokeUiSession`] implementation for the laboratory seam.
+///
+/// UI/media/input callbacks that are not part of the frame-lifetime path are
+/// refused. [`InvokeUiSession::on_rgba`] refuses production media (no sealed
+/// admitted context). `get_rgba` returns null: no borrowed upstream buffer is
+/// ever published.
+#[derive(Clone)]
+pub struct NativeHandler {
+    /// Count of refused/unsupported callbacks. Laboratory observability only.
+    refused: Arc<AtomicU32>,
+    /// Frame generation fence observed at the last accepted frame.
+    generation: Arc<AtomicU32>,
+    /// Bounded latest-frame store shared with the owning context.
+    frames: Arc<FrameStore>,
+    /// Lifecycle delivery queue shared with the owning context.
+    life: Arc<Mutex<LifeQueue>>,
+    /// Signaled when an event is queued, cancelled, or a callback returns.
+    life_cv: Arc<Condvar>,
+}
+
+impl Default for NativeHandler {
+    fn default() -> Self {
+        Self {
+            refused: Arc::new(AtomicU32::new(0)),
+            generation: Arc::new(AtomicU32::new(1)),
+            frames: Arc::new(FrameStore::default()),
+            life: Arc::new(Mutex::new(LifeQueue {
+                q: VecDeque::new(),
+                cb: None,
+                user: UserPtr(std::ptr::null_mut()),
+                retired: Vec::new(),
+                cancelled: false,
+                dropped: 0,
+                inflight: false,
+                worker_done: false,
+            })),
+            life_cv: Arc::new(Condvar::new()),
+        }
+    }
+}
+
+/// Spawn the bounded lifecycle delivery worker.
+///
+/// The worker pops events, invokes the registered callback **without holding
+/// [`LifeQueue`]**, and exits once cancelled and drained. Exactly one worker
+/// runs per handler. The returned handle must be stored on the context so
+/// [`hs_viewer_drain`] can join it.
+fn spawn_life_worker(
+    life: Arc<Mutex<LifeQueue>>,
+    life_cv: Arc<Condvar>,
+) -> std::thread::JoinHandle<()> {
+    std::thread::Builder::new()
+        .name("hs-life-delivery".into())
+        .spawn(move || {
+            loop {
+                // Pop one event, or wait for work / cancellation.
+                let event = {
+                    let mut q = match life.lock() {
+                        Ok(q) => q,
+                        Err(_) => return,
+                    };
+                    loop {
+                        // Deliver only when a callback is registered. Events
+                        // queued with no callback are retained for
+                        // `hs_viewer_poll_life` and must not be discarded here.
+                        if q.cb.is_some() {
+                            if let Some(ev) = q.q.pop_front() {
+                                break Some(ev);
+                            }
+                        }
+                        if q.cancelled {
+                            q.worker_done = true;
+                            break None;
+                        }
+                        // Timed wait so cancellation is observed even when idle.
+                        match life_cv.wait_timeout(q, Duration::from_millis(20)) {
+                            Ok((guard, _)) => q = guard,
+                            Err(_) => return,
+                        }
+                    }
+                };
+                let Some(ev) = event else {
+                    // Cancelled and empty: signal waiters and exit.
+                    life_cv.notify_all();
+                    return;
+                };
+                // Snapshot cb/user without holding the lock across the call.
+                let (cb, user) = {
+                    let mut q = match life.lock() {
+                        Ok(q) => q,
+                        Err(_) => return,
+                    };
+                    q.inflight = true;
+                    (q.cb, q.user)
+                };
+                if let Some(cb) = cb {
+                    // SAFETY: user is the caller-registered pointer, valid until
+                    // drain completes. The callback is invoked with no locks held.
+                    cb(user.0, ev.code, ev.generation);
+                }
+                {
+                    let mut q = match life.lock() {
+                        Ok(q) => q,
+                        Err(_) => return,
+                    };
+                    q.inflight = false;
+                }
+                life_cv.notify_all();
+            }
+        })
+        .expect("hs_native: lifecycle delivery worker spawn")
+}
+
+impl NativeHandler {
+    /// Number of refused callbacks observed on this handler.
+    pub fn refused_count(&self) -> u32 {
+        self.refused.load(Ordering::Relaxed)
+    }
+
+    fn refuse(&self) {
+        self.refused.fetch_add(1, Ordering::Relaxed);
+    }
+
+    /// Queue a lifecycle event. Bounded: overflow drops and counts.
+    fn queue_life(&self, code: u32, generation: u32) {
+        let mut q = match self.life.lock() {
+            Ok(q) => q,
+            Err(_) => return,
+        };
+        if q.cancelled && code != HS_LIFE_DRAINED {
+            q.dropped = q.dropped.saturating_add(1);
+            return;
+        }
+        if q.q.len() >= HS_MAX_LIFE_QUEUE {
+            q.dropped = q.dropped.saturating_add(1);
+            return;
+        }
+        q.q.push_back(LifeEvent { code, generation });
+        drop(q);
+        self.life_cv.notify_all();
+    }
+
+    /// Accept one real [`ImageRgb`] into the owned frame path.
+    ///
+    /// `fences` must come from a sealed admitted context (see
+    /// [`AdmissionFences`]). There is no caller-supplied boolean or fixture
+    /// token that grants production media. Tests use
+    /// [`NativeHandler::fixture_admit_frame`] (cfg(test) only) and must be
+    /// labelled fixture lifetime checks.
+    fn admit_rgba(
+        &self,
+        display: usize,
+        fences: AdmissionFences,
+        rgba: &ImageRgb,
+    ) -> Result<u64, u32> {
+        // Reject unsealed/zero/out-of-range fences before any sequence burn.
+        AdmissionFences::new(fences.layout_generation, fences.interaction_generation)?;
+        let viewer_generation = self.generation.load(Ordering::SeqCst);
+        let display_u = u32::try_from(display).map_err(|_| HS_STATUS_BOUNDS)?;
+        // Validate geometry before assigning a sequence so rejected frames do
+        // not burn monotonic sequence numbers.
+        let format = format_code(rgba.fmt);
+        let align = u32::try_from(rgba.align).map_err(|_| HS_STATUS_BOUNDS)?;
+        let width = u32::try_from(rgba.w).map_err(|_| HS_STATUS_BOUNDS)?;
+        let height = u32::try_from(rgba.h).map_err(|_| HS_STATUS_BOUNDS)?;
+        let payload_len = u32::try_from(rgba.raw.len()).map_err(|_| HS_STATUS_BOUNDS)?;
+        let stride = validate_frame_geometry(width, height, format, align, payload_len)?;
+        let seq = self.frames.next_sequence();
+        let frame = Arc::new(OwnedFrame {
+            pixels: Arc::from(rgba.raw.as_slice()),
+            desc: FrameDesc {
+                width,
+                height,
+                stride,
+                format,
+                length: payload_len,
+                display: display_u,
+                viewer_generation,
+                layout_generation: fences.layout_generation,
+                interaction_generation: fences.interaction_generation,
+                sequence: seq,
+            },
+        });
+        self.frames.publish(Arc::clone(&frame));
+        self.queue_life(HS_LIFE_FRAME_READY, viewer_generation);
+        Ok(seq)
+    }
+
+    /// cfg(test)-only fixture admission. Not exported. Not a production media
+    /// grant. Every call site must be labelled a fixture lifetime check.
+    #[cfg(test)]
+    fn fixture_admit_frame(
+        &self,
+        display: usize,
+        fences: AdmissionFences,
+        rgba: &ImageRgb,
+    ) -> Result<u64, u32> {
+        self.admit_rgba(display, fences, rgba)
+    }
+}
