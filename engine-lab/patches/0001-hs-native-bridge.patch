+// ---------------------------------------------------------------------------
+// Lifecycle callbacks
+// ---------------------------------------------------------------------------
+
+/// Lifecycle callback signature.
+///
+/// Invoked on the bounded internal delivery worker (never the caller thread,
+/// never assumed to be a UI thread). `user` is the pointer registered with
+/// [`hs_viewer_set_lifecycle_cb`]. See module docs for the full contract.
+pub type HsLifecycleCb = Option<extern "C" fn(*mut c_void, u32, u32)>;
+
+/// Register (or clear, with `cb = null`) the lifecycle callback.
+///
+/// `user` is passed through unchanged. The callback is invoked only from the
+/// delivery worker. Clearing the callback while a delivery is in flight is
+/// safe; the in-flight call completes and no further events are delivered.
+///
+/// **Registration is refused** ([`HS_STATUS_STATE`]) after [`hs_viewer_drain`]
+/// has completed or once the context is Closing/Closed, so root publication
+/// cannot race a successful drain. Replacements are bounded by
+/// [`HS_MAX_LIFE_RETIRED`]; exceeding that returns [`HS_STATUS_EXHAUSTED`].
+/// Native code does not root foreign runtime objects — the caller keeps its
+/// userdata alive until drain.
+///
+/// Atomicity: the state check, handler lookup, and life-queue mutation run
+/// under the state guard (lock order `state` → `session` → `life`). A
+/// concurrent [`hs_viewer_request_close`] + [`hs_viewer_drain`] cannot slip
+/// between the check and the publication, so no foreign root is accepted
+/// after close/drain.
+#[no_mangle]
+pub extern "C" fn hs_viewer_set_lifecycle_cb(
+    ctx: *mut HsEngineCtx,
+    cb: HsLifecycleCb,
+    user: *mut c_void,
+) -> u32 {
+    with_ctx(ctx, |c| {
+        // Hold the state guard through registration. Lock order is
+        // state -> session -> life (same as request_close / prepare).
+        let state = c.lock_state()?;
+        match *state {
+            SessionState::Prepared => {}
+            SessionState::Created | SessionState::Closing | SessionState::Closed => {
+                return Err(HS_STATUS_STATE);
+            }
+        }
+        let handler = {
+            let slot = c.lock_session()?;
+            slot.as_ref()
+                .map(|s| s.ui_handler.clone())
+                .ok_or(HS_STATUS_STATE)?
+        };
+        let mut q = handler.life.lock().map_err(|_| HS_STATUS_INTERNAL)?;
+        // Bound replacements. Native cannot root foreign objects; this only
+        // records prior pairs so callers can reason about quiescence.
+        if q.cb.is_some() && q.retired.len() >= HS_MAX_LIFE_RETIRED {
+            return Err(HS_STATUS_EXHAUSTED);
+        }
+        if q.cb.is_some() {
+            let old_cb = q.cb;
+            let old_user = q.user;
+            q.retired.push((old_cb, old_user));
+        }
+        q.cb = cb;
+        q.user = UserPtr(user);
+        drop(q);
+        drop(state);
+        handler.life_cv.notify_all();
+        Ok(HS_STATUS_OK)
+    })
+}
+
+/// Non-blocking pump of one lifecycle event, for callers that prefer polling
+/// over a callback. Returns [`HS_STATUS_OK`] and writes the event code and
+/// generation, or [`HS_STATUS_STATE`] when the queue is empty.
+#[no_mangle]
+pub extern "C" fn hs_viewer_poll_life(
+    ctx: *mut HsEngineCtx,
+    out_code: *mut u32,
+    out_generation: *mut u32,
+) -> u32 {
+    with_ctx(ctx, |c| {
+        if out_code.is_null() || out_generation.is_null() {
+            return Err(HS_STATUS_NULL);
+        }
+        let handler = c.handler()?.ok_or(HS_STATUS_STATE)?;
+        let mut q = handler.life.lock().map_err(|_| HS_STATUS_INTERNAL)?;
+        match q.q.pop_front() {
+            Some(ev) => {
+                // SAFETY: non-null caller storage.
+                unsafe {
+                    *out_code = ev.code;
+                    *out_generation = ev.generation;
+                }
+                Ok(HS_STATUS_OK)
+            }
+            None => Err(HS_STATUS_STATE),
+        }
+    })
+}
+
+// ---------------------------------------------------------------------------
+// Fail-closed handshake prerequisites (helper-only validation)
+// ---------------------------------------------------------------------------
+//
+// These helpers are **pure validators** used to gate the HS-native seam. They
+// are NOT wired into `client::secure_connection` or the endpoint
+// `server::identity_handshake`. The actual transport/relay/admission gate is
+// **NOT PROVED** by exercising these helpers. Do not label helper-only tests
+// a secure route pass.
+//
+// All normal connect / observe / channel-export calls remain unavailable
+// until actual secure binding and endpoint admission are wired.
+
+/// Transport kinds considered by the HS-selected path.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+#[repr(u32)]
+pub enum HsTransportKind {
+    /// Coordinated TCP via the selected rendezvous/relay path.
+    TcpCoordinated = 0,
+    /// Direct TCP punch.
+    TcpDirect = 1,
+    /// WebRTC — disabled until separately proved.
+    WebRtc = 2,
+    /// WebSocket — disabled until separately proved.
+    WebSocket = 3,
+}
+
+/// Fail-closed transport gate. WebRTC and WebSocket remain disabled until
+/// separately proved. No alternative route is opened here.
+pub fn transport_enabled(kind: HsTransportKind) -> bool {
+    match kind {
+        HsTransportKind::TcpCoordinated | HsTransportKind::TcpDirect => true,
+        HsTransportKind::WebRtc | HsTransportKind::WebSocket => false,
+    }
+}
+
+/// Refuse a missing, empty, or wrong-length configured root (32-byte
+/// Ed25519 public key). All-zero roots are refused as placeholders.
+pub fn validate_configured_root(root: &[u8]) -> Result<(), u32> {
+    if root.len() != 32 {
+        return Err(HS_STATUS_HANDSHAKE);
+    }
+    if root.iter().all(|b| *b == 0) {
+        return Err(HS_STATUS_HANDSHAKE);
+    }
+    Ok(())
+}
+
+/// Refuse a wrong peer identity or public key against the expected enrolled
+/// values. Empty expected values fail closed (no enrolled identity).
+pub fn validate_peer_identity(
+    expected_id: &str,
+    presented_id: &str,
+    expected_pk: &[u8],
+    presented_pk: &[u8],
+) -> Result<(), u32> {
+    if expected_id.is_empty() || expected_pk.len() != 32 {
+        return Err(HS_STATUS_HANDSHAKE);
+    }
+    if expected_pk.iter().all(|b| *b == 0) {
+        return Err(HS_STATUS_HANDSHAKE);
+    }
+    if presented_id != expected_id {
+        return Err(HS_STATUS_HANDSHAKE);
+    }
+    if presented_pk.len() != 32 || presented_pk != expected_pk {
+        return Err(HS_STATUS_HANDSHAKE);
+    }
+    Ok(())
+}
+
+/// Refuse an insecure fallback: empty key material, or an explicit
+/// allow-insecure flag. Authentication failure may never fall back to
+/// plaintext, legacy password, or a user-approved insecure mode.
+pub fn refuse_insecure_fallback(
+    has_trusted_identity: bool,
+    allow_insecure: bool,
+    transport_is_encrypted: bool,
+) -> Result<(), u32> {
+    if allow_insecure {
+        return Err(HS_STATUS_HANDSHAKE);
+    }
+    if !has_trusted_identity {
+        return Err(HS_STATUS_HANDSHAKE);
+    }
+    if !transport_is_encrypted {
+        return Err(HS_STATUS_HANDSHAKE);
+    }
+    Ok(())
+}
+
+/// Refuse a raw IP/domain locator used as a bypass of the authenticated
+/// handshake. Locators are not identities. An empty locator fails closed.
+pub fn refuse_raw_locator_bypass(locator: &str) -> Result<(), u32> {
+    let trimmed = locator.trim();
+    if trimmed.is_empty() {
+        return Err(HS_STATUS_HANDSHAKE);
+    }
+    // A bare IPv4/IPv6 literal (with optional port) is a locator, not proof
+    // of authenticated encrypted transport. The selected path must present a
+    // configured root + enrolled identity; this helper rejects treating the
+    // locator alone as sufficient.
+    let host = trimmed.rsplit_once(':').map(|(h, _)| h).unwrap_or(trimmed);
+    let host = host.trim_start_matches('[').trim_end_matches(']');
+    if host.parse::<std::net::IpAddr>().is_ok() {
+        return Err(HS_STATUS_HANDSHAKE);
+    }
+    Ok(())
+}
+
+/// Channel-binding export status.
+///
+/// The HS channel-binding primitive must be derived from the **actual**
+/// successfully authenticated negotiated encryption state — never from a
+/// caller-provided transcript, hash, or fixture constant. Until a real
+/// authenticated channel presents that state to this seam, binding export
+/// stays unavailable. The precise missing seam is: a completed
+/// `secure_connection`/`Stream::is_secured() == true` whose `Encrypt` key
+/// material is visible to `hs_native` and bound to the HS admission token.
+///
+/// Returns [`HS_STATUS_UNAVAILABLE`] always. No binding bytes are produced.
+#[no_mangle]
+pub extern "C" fn hs_channel_binding_export(
+    ctx: *mut HsEngineCtx,
+    out_binding: *mut u8,
+    out_len: *mut u32,
+) -> u32 {
+    with_ctx(ctx, |_c| {
+        let _ = (out_binding, out_len);
+        Err(HS_STATUS_UNAVAILABLE)
+    })
+}
+
+/// Apply the fail-closed handshake prerequisites for the selected TCP
+/// direct/coordinated-relay path. Returns [`HS_STATUS_OK`] only when every
+/// prerequisite holds.
+///
+/// **Helper-only.** This validator is not called from
+/// `client::secure_connection` or `server::identity_handshake`. A pass here
+/// is not a secure-route pass. The actual transport/relay/admission gate is
+/// NOT PROVED.
+pub fn require_handshake_prerequisites(
+    transport: HsTransportKind,
+    root: &[u8],
+    expected_id: &str,
+    presented_id: &str,
+    expected_pk: &[u8],
+    presented_pk: &[u8],
+    locator: &str,
+    has_trusted_identity: bool,
+    allow_insecure: bool,
+    transport_is_encrypted: bool,
+) -> Result<(), u32> {
+    if !transport_enabled(transport) {
+        return Err(HS_STATUS_HANDSHAKE);
+    }
+    validate_configured_root(root)?;
+    validate_peer_identity(expected_id, presented_id, expected_pk, presented_pk)?;
+    refuse_raw_locator_bypass(locator)?;
+    refuse_insecure_fallback(has_trusted_identity, allow_insecure, transport_is_encrypted)?;
+    Ok(())
+}
