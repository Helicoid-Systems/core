+    /// Real callback execution: a registered callback runs on the delivery
+    /// worker and may call `request_close` without deadlocking. Not polling.
+    #[test]
+    fn real_callback_runs_and_close_from_callback_is_safe() {
+        use std::sync::atomic::AtomicUsize;
+        static CALLS: AtomicUsize = AtomicUsize::new(0);
+        static SAW_CLOSING: AtomicUsize = AtomicUsize::new(0);
+
+        extern "C" fn cb(_user: *mut c_void, code: u32, _gen: u32) {
+            CALLS.fetch_add(1, Ordering::SeqCst);
+            if code == HS_LIFE_CLOSING {
+                SAW_CLOSING.fetch_add(1, Ordering::SeqCst);
+            }
+        }
+
+        let out = Box::into_raw(Box::new(HsEngineCtx::new()));
+        assert_eq!(hs_viewer_prepare(out), HS_STATUS_OK);
+        assert_eq!(
+            hs_viewer_set_lifecycle_cb(out, Some(cb), std::ptr::null_mut()),
+            HS_STATUS_OK
+        );
+        // Queue a real event; the worker must deliver it to the callback.
+        {
+            let ctx = unsafe { &*out };
+            let handler = ctx.handler().unwrap().unwrap();
+            handler.queue_life(HS_LIFE_FRAME_READY, 1);
+        }
+        // Close from the test thread while the worker may be mid-callback.
+        assert_eq!(hs_viewer_request_close(out), HS_STATUS_OK);
+        assert_eq!(hs_viewer_drain(out, 1000), HS_STATUS_OK);
+        assert!(CALLS.load(Ordering::SeqCst) >= 1, "callback must have run");
+        assert_eq!(
+            SAW_CLOSING.load(Ordering::SeqCst),
+            1,
+            "CLOSING lifecycle event delivered to callback"
+        );
+        assert_eq!(hs_engine_ctx_free(out), HS_STATUS_OK);
+    }
+
+    /// Real callback calling `request_close` from inside the worker must not
+    /// deadlock: drain on another thread completes after the callback returns.
+    #[test]
+    fn real_callback_calls_request_close_without_deadlock() {
+        use std::sync::atomic::AtomicUsize;
+        static CLOSE_FROM_CB: AtomicUsize = AtomicUsize::new(0);
+
+        extern "C" fn cb(user: *mut c_void, code: u32, _gen: u32) {
+            if code == HS_LIFE_CLOSING {
+                let ctx = user as *mut HsEngineCtx;
+                if !ctx.is_null() {
+                    let st = hs_viewer_request_close(ctx);
+                    if st == HS_STATUS_OK || st == HS_STATUS_STATE {
+                        CLOSE_FROM_CB.fetch_add(1, Ordering::SeqCst);
+                    }
+                }
+            }
+        }
+
+        let out = Box::into_raw(Box::new(HsEngineCtx::new()));
+        assert_eq!(hs_viewer_prepare(out), HS_STATUS_OK);
+        assert_eq!(
+            hs_viewer_set_lifecycle_cb(out, Some(cb), out as *mut c_void),
+            HS_STATUS_OK
+        );
+        // Trigger CLOSING from the normal close path; the callback re-enters
+        // request_close. That must be idempotent and non-deadlocking.
+        assert_eq!(hs_viewer_request_close(out), HS_STATUS_OK);
+        assert_eq!(hs_viewer_drain(out, 1000), HS_STATUS_OK);
+        assert_eq!(
+            CLOSE_FROM_CB.load(Ordering::SeqCst),
+            1,
+            "callback re-entered request_close"
+        );
+        assert_eq!(hs_engine_ctx_free(out), HS_STATUS_OK);
+    }
