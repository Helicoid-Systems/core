+fn read_perm_flag(
+    c: &HsEngineCtx,
+    out_enabled: *mut u32,
+    read: impl FnOnce(&Session<NativeHandler>) -> Result<bool, u32>,
+) -> Result<u32, u32> {
+    if out_enabled.is_null() {
+        return Err(HS_STATUS_NULL);
+    }
+    if c.state()? != SessionState::Prepared {
+        return Err(HS_STATUS_STATE);
+    }
+    let slot = c.lock_session()?;
+    let session = slot.as_ref().ok_or(HS_STATUS_INTERNAL)?;
+    let enabled = read(session)? as u32;
+    // SAFETY: `out_enabled` is non-null caller storage for one u32.
+    unsafe {
+        *out_enabled = enabled;
+    }
+    Ok(HS_STATUS_OK)
+}
