+/// Report frame-store counters: published, disposed (late/superseded), and
+/// the monotonic sequence high-water mark.
+#[no_mangle]
+pub extern "C" fn hs_frame_stats(
+    ctx: *mut HsEngineCtx,
+    out_published: *mut u64,
+    out_disposed: *mut u64,
+    out_seq: *mut u64,
+) -> u32 {
+    with_ctx(ctx, |c| {
+        if out_published.is_null() || out_disposed.is_null() || out_seq.is_null() {
+            return Err(HS_STATUS_NULL);
+        }
+        let handler = c.handler()?.ok_or(HS_STATUS_STATE)?;
+        // SAFETY: non-null caller storage.
+        unsafe {
+            *out_published = handler.frames.published.load(Ordering::Relaxed);
+            *out_disposed = handler.frames.disposed.load(Ordering::Relaxed);
+            *out_seq = handler.frames.sequence.load(Ordering::Relaxed);
+        }
+        Ok(HS_STATUS_OK)
+    })
+}
