+struct CtxInner {
+    state: Mutex<SessionState>,
+    /// Real inert session. `Some` only while [`SessionState::Prepared`].
+    session: Mutex<Option<Session<NativeHandler>>>,
+    /// Incremented on every contained panic so the harness can observe it.
+    panics_contained: AtomicU32,
+    /// Generation fence. Exhaustion fails closed; it does not wrap.
+    generation: AtomicU32,
+    /// Delivery worker handle; joined by drain, never by free-before-drain.
+    worker: Mutex<Option<std::thread::JoinHandle<()>>>,
+    /// Lifecycle queue shared with the worker. Kept after Session drop so
+    /// drain can observe `worker_done` even once the session is gone.
+    life: Mutex<Option<Arc<Mutex<LifeQueue>>>>,
+    life_cv: Mutex<Option<Arc<Condvar>>>,
+}
+
+/// Opaque viewer/engine context. Owns at most one real [`Session`].
+pub struct HsEngineCtx {
+    inner: Arc<CtxInner>,
+}
+
+impl HsEngineCtx {
+    fn new() -> Self {
+        Self {
+            inner: Arc::new(CtxInner {
+                state: Mutex::new(SessionState::Created),
+                session: Mutex::new(None),
+                panics_contained: AtomicU32::new(0),
+                generation: AtomicU32::new(1),
+                worker: Mutex::new(None),
+                life: Mutex::new(None),
+                life_cv: Mutex::new(None),
+            }),
+        }
+    }
+
+    /// Lock the state. Poison fails closed: the caller gets [`HS_STATUS_INTERNAL`]
+    /// and must not proceed. There is no poisoned-mutex recovery that admits work.
+    fn lock_state(&self) -> Result<MutexGuard<'_, SessionState>, u32> {
+        self.inner.state.lock().map_err(|_| HS_STATUS_INTERNAL)
+    }
+
+    fn lock_session(&self) -> Result<MutexGuard<'_, Option<Session<NativeHandler>>>, u32> {
+        self.inner.session.lock().map_err(|_| HS_STATUS_INTERNAL)
+    }
+
+    fn state(&self) -> Result<SessionState, u32> {
+        Ok(*self.lock_state()?)
+    }
+
+    /// Bump the generation fence. On exhaustion return [`HS_STATUS_EXHAUSTED`]
+    /// and refuse further work. The counter never wraps.
+    fn bump_generation(&self) -> Result<u32, u32> {
+        self.inner
+            .generation
+            .try_update(Ordering::SeqCst, Ordering::SeqCst, |g| g.checked_add(1))
+            .map_err(|_| HS_STATUS_EXHAUSTED)
+    }
+
+    fn handler(&self) -> Result<Option<NativeHandler>, u32> {
+        let slot = self.lock_session()?;
+        Ok(slot.as_ref().map(|s| s.ui_handler.clone()))
+    }
+}
