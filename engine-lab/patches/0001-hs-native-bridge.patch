+    /// Slow callback: drain with a short deadline times out, a later drain
+    /// succeeds once the callback returns. Proves real outstanding work.
+    #[test]
+    fn slow_callback_times_out_then_later_drain_succeeds() {
+        use std::sync::atomic::AtomicUsize;
+        static STARTED: AtomicUsize = AtomicUsize::new(0);
+        static FINISHED: AtomicUsize = AtomicUsize::new(0);
+
+        extern "C" fn cb(_user: *mut c_void, code: u32, _gen: u32) {
+            if code == HS_LIFE_CLOSING {
+                STARTED.fetch_add(1, Ordering::SeqCst);
+                std::thread::sleep(Duration::from_millis(200));
+                FINISHED.fetch_add(1, Ordering::SeqCst);
+            }
+        }
+
+        let out = Box::into_raw(Box::new(HsEngineCtx::new()));
+        assert_eq!(hs_viewer_prepare(out), HS_STATUS_OK);
+        assert_eq!(
+            hs_viewer_set_lifecycle_cb(out, Some(cb), std::ptr::null_mut()),
+            HS_STATUS_OK
+        );
+        assert_eq!(hs_viewer_request_close(out), HS_STATUS_OK);
+        // Short deadline: the slow CLOSING callback is still running.
+        let early = hs_viewer_drain(out, 20);
+        assert_eq!(
+            early, HS_STATUS_TIMEOUT,
+            "short drain times out on slow callback"
+        );
+        assert_eq!(
+            hs_engine_ctx_free(out),
+            HS_STATUS_STATE,
+            "free refused while work outstanding"
+        );
+        // Later drain waits out the remaining callback.
+        assert_eq!(hs_viewer_drain(out, 1000), HS_STATUS_OK);
+        assert_eq!(
+            FINISHED.load(Ordering::SeqCst),
+            1,
+            "slow callback completed"
+        );
+        assert_eq!(hs_engine_ctx_free(out), HS_STATUS_OK);
+    }
