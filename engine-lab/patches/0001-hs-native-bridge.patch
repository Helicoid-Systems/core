+// ---------------------------------------------------------------------------
+// Frame ownership ABI
+// ---------------------------------------------------------------------------
+
+/// Acquire the latest owned frame for `display`.
+///
+/// On success `out_frame` receives an owned [`HsFrame`] handle that must be
+/// released with [`hs_frame_release`] (same Rust allocator; never C `free`).
+/// `out_desc` receives a copy of the validated descriptor.
+///
+/// Outstanding handles remain valid after observation close until released.
+/// Returns [`HS_STATUS_STATE`] when no frame is available in the current state.
+#[no_mangle]
+pub extern "C" fn hs_frame_acquire_latest(
+    ctx: *mut HsEngineCtx,
+    display: u32,
+    out_frame: *mut *mut HsFrame,
+    out_desc: *mut HsFrameDesc,
+) -> u32 {
+    with_ctx(ctx, |c| {
+        if out_frame.is_null() || out_desc.is_null() {
+            return Err(HS_STATUS_NULL);
+        }
+        if c.state()? != SessionState::Prepared {
+            return Err(HS_STATUS_STATE);
+        }
+        let handler = c.handler()?.ok_or(HS_STATUS_INTERNAL)?;
+        let frame = handler.frames.latest(display).ok_or(HS_STATUS_STATE)?;
+        let desc = HsFrameDesc::from(frame.desc);
+        let handle = Box::into_raw(Box::new(HsFrame { inner: frame }));
+        // SAFETY: out_frame/out_desc are non-null caller storage.
+        unsafe {
+            *out_frame = handle;
+            *out_desc = desc;
+        }
+        Ok(HS_STATUS_OK)
+    })
+}
+
+/// Borrow the immutable pixel pointer and length of an owned frame.
+///
+/// The pointer stays valid until [`hs_frame_release`]. No copy is made and no
+/// mutable upstream pointer is exposed.
+#[no_mangle]
+pub extern "C" fn hs_frame_pixels(
+    frame: *const HsFrame,
+    out_ptr: *mut *const u8,
+    out_len: *mut u32,
+) -> u32 {
+    match catch_unwind(AssertUnwindSafe(|| {
+        if frame.is_null() || out_ptr.is_null() || out_len.is_null() {
+            return HS_STATUS_NULL;
+        }
+        // SAFETY: frame is a live handle from hs_frame_acquire_latest.
+        let f = unsafe { &*frame };
+        let pixels = f.pixels();
+        // SAFETY: non-null caller storage.
+        unsafe {
+            *out_ptr = pixels.as_ptr();
+            *out_len = f.desc().length;
+        }
+        HS_STATUS_OK
+    })) {
+        Ok(code) => code,
+        Err(_) => HS_STATUS_PANIC,
+    }
+}
+
+/// Read the descriptor of an owned frame.
+#[no_mangle]
+pub extern "C" fn hs_frame_get_desc(frame: *const HsFrame, out_desc: *mut HsFrameDesc) -> u32 {
+    match catch_unwind(AssertUnwindSafe(|| {
+        if frame.is_null() || out_desc.is_null() {
+            return HS_STATUS_NULL;
+        }
+        // SAFETY: frame is a live handle from hs_frame_acquire_latest.
+        let f = unsafe { &*frame };
+        // SAFETY: non-null caller storage.
+        unsafe {
+            *out_desc = HsFrameDesc::from(*f.desc());
+        }
+        HS_STATUS_OK
+    })) {
+        Ok(code) => code,
+        Err(_) => HS_STATUS_PANIC,
+    }
+}
+
+/// Release an owned frame handle. Null is accepted and ignored.
+///
+/// Exact allocator release: the Rust allocation is dropped here. Do not free
+/// the pixel pointer with a different allocator. Double-release is UB.
+#[no_mangle]
+pub extern "C" fn hs_frame_release(frame: *mut HsFrame) -> u32 {
+    match catch_unwind(AssertUnwindSafe(|| {
+        if frame.is_null() {
+            return HS_STATUS_OK;
+        }
+        // SAFETY: handle from hs_frame_acquire_latest, not yet released.
+        drop(unsafe { Box::from_raw(frame) });
+        HS_STATUS_OK
+    })) {
+        Ok(code) => code,
+        Err(_) => HS_STATUS_PANIC,
+    }
+}
