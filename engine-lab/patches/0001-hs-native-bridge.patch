+    /// Parallel close requests: exactly one generation bump and exactly one
+    /// CLOSING delivery. Re-entrant close from the callback is idempotent.
+    #[test]
+    fn parallel_close_requests_one_generation_bump_one_closing() {
+        use std::sync::atomic::AtomicUsize;
+        static CLOSING_DELIVERED: AtomicUsize = AtomicUsize::new(0);
+
+        extern "C" fn cb(_u: *mut c_void, code: u32, _g: u32) {
+            if code == HS_LIFE_CLOSING {
+                CLOSING_DELIVERED.fetch_add(1, Ordering::SeqCst);
+            }
+        }
+
+        let out = Box::into_raw(Box::new(HsEngineCtx::new()));
+        assert_eq!(hs_viewer_prepare(out), HS_STATUS_OK);
+        let mut gen_before = 0u32;
+        assert_eq!(hs_generation(out, &mut gen_before), HS_STATUS_OK);
+        assert_eq!(
+            hs_viewer_set_lifecycle_cb(out, Some(cb), std::ptr::null_mut()),
+            HS_STATUS_OK
+        );
+
+        // N parallel close requests. Exactly one may transition Created/Prepared
+        // -> Closing; the rest observe Closing and return OK without a bump.
+        let mut handles = Vec::new();
+        for _ in 0..8 {
+            let addr = out as usize;
+            handles.push(std::thread::spawn(move || {
+                hs_viewer_request_close(addr as *mut HsEngineCtx)
+            }));
+        }
+        let mut ok = 0;
+        for h in handles {
+            assert_eq!(h.join().unwrap(), HS_STATUS_OK, "every parallel close returns OK");
+            ok += 1;
+        }
+        assert_eq!(ok, 8);
+
+        let mut gen_after = 0u32;
+        assert_eq!(hs_generation(out, &mut gen_after), HS_STATUS_OK);
+        assert_eq!(
+            gen_after,
+            gen_before + 1,
+            "exactly one generation bump across parallel close"
+        );
+
+        assert_eq!(hs_viewer_drain(out, 1000), HS_STATUS_OK);
+        assert_eq!(
+            CLOSING_DELIVERED.load(Ordering::SeqCst),
+            1,
+            "exactly one CLOSING event delivered"
+        );
+        assert_eq!(hs_engine_ctx_free(out), HS_STATUS_OK);
+    }
