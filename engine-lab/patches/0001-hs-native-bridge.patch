+    /// Helper-only handshake validation. NOT a secure route pass: these
+    /// validators are not wired into `client::secure_connection` or
+    /// `server::identity_handshake`.
+    #[test]
+    fn handshake_fail_closed_prerequisites() {
+        let root = [7u8; 32];
+        let pk = [9u8; 32];
+        // Happy path for TCP direct with all prerequisites.
+        assert_eq!(
+            require_handshake_prerequisites(
+                HsTransportKind::TcpDirect,
+                &root,
+                "peer-a",
+                "peer-a",
+                &pk,
+                &pk,
+                "rendezvous.example.com:21116",
+                true,
+                false,
+                true,
+            ),
+            Ok(())
+        );
+
+        // Missing/invalid root.
+        assert_eq!(validate_configured_root(&[]), Err(HS_STATUS_HANDSHAKE));
+        assert_eq!(
+            validate_configured_root(&[0u8; 32]),
+            Err(HS_STATUS_HANDSHAKE)
+        );
+
+        // Wrong id / wrong key.
+        assert_eq!(
+            validate_peer_identity("peer-a", "peer-b", &pk, &pk),
+            Err(HS_STATUS_HANDSHAKE)
+        );
+        assert_eq!(
+            validate_peer_identity("peer-a", "peer-a", &pk, &[1u8; 32]),
+            Err(HS_STATUS_HANDSHAKE)
+        );
+
+        // Insecure fallback refused.
+        assert_eq!(
+            refuse_insecure_fallback(true, true, true),
+            Err(HS_STATUS_HANDSHAKE)
+        );
+        assert_eq!(
+            refuse_insecure_fallback(false, false, true),
+            Err(HS_STATUS_HANDSHAKE)
+        );
+        assert_eq!(
+            refuse_insecure_fallback(true, false, false),
+            Err(HS_STATUS_HANDSHAKE)
+        );
+
+        // Raw IP locator bypass refused; domain locator allowed.
+        assert_eq!(
+            refuse_raw_locator_bypass("203.0.113.5:21116"),
+            Err(HS_STATUS_HANDSHAKE)
+        );
+        assert_eq!(
+            refuse_raw_locator_bypass("[2001:db8::1]:21116"),
+            Err(HS_STATUS_HANDSHAKE)
+        );
+        assert_eq!(
+            refuse_raw_locator_bypass("rendezvous.example.com:21116"),
+            Ok(())
+        );
+        assert_eq!(refuse_raw_locator_bypass(""), Err(HS_STATUS_HANDSHAKE));
