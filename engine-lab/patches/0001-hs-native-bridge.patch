+            panic!("poison probe");
+        }));
+        // After poison, state reads must fail closed (INTERNAL), not recover
+        // into admitting work.
+        assert_eq!(ctx.lock_state().err(), Some(HS_STATUS_INTERNAL));
+        assert_eq!(ctx.state(), Err(HS_STATUS_INTERNAL));
+    }
