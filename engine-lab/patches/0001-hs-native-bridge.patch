+/// Construct a new engine context. Does **not** construct the [`Session`] yet.
+///
+/// `out` receives an opaque pointer. Caller must free with
+/// [`hs_engine_ctx_free`] exactly once. A null `out` is rejected.
+///
+/// Prerequisites: `out` must be non-null and point to writable pointer-sized
+/// storage. These functions do not detect double-free.
+#[no_mangle]
+pub extern "C" fn hs_engine_ctx_new(out: *mut *mut HsEngineCtx) -> u32 {
+    match catch_unwind(|| {
+        if out.is_null() {
+            return HS_STATUS_NULL;
+        }
+        let ctx = HsEngineCtx::new();
+        // SAFETY: `out` is non-null caller-provided storage for one pointer.
+        unsafe {
+            *out = Box::into_raw(Box::new(ctx));
+        }
+        HS_STATUS_OK
+    }) {
+        Ok(code) => code,
+        Err(_) => HS_STATUS_PANIC,
+    }
+}
+
+/// Free a context. Null is accepted and ignored.
+///
+/// If the context still owns a [`Session`], it is dropped here.
+///
+/// Prerequisites (not checked; violating them is UB):
+///  - `ctx` must come from [`hs_engine_ctx_new`] and not have been freed.
+///  - No other call on this context may be in progress.
+///  - The pointer must not be used afterwards.
+///  - If the delivery worker is still live or drain has not completed,
+///    [`hs_viewer_drain`] must run first. Freeing with outstanding work is
+///    refused ([`HS_STATUS_STATE`]); the pointer remains valid and must be
+///    drained then freed.
+///
+/// This function does **not** detect double-free. A double-free is undefined
+/// behaviour; it is not converted into a status code.
+#[no_mangle]
+pub extern "C" fn hs_engine_ctx_free(ctx: *mut HsEngineCtx) -> u32 {
+    match catch_unwind(|| {
+        if ctx.is_null() {
+            return HS_STATUS_OK;
+        }
+        // SAFETY: pointer came from hs_engine_ctx_new and has not been freed.
+        let owned = unsafe { Box::from_raw(ctx) };
+        // Refuse free while the delivery worker is still live.
+        let worker_live = owned
+            .inner
+            .worker
+            .lock()
+            .map(|w| w.is_some())
+            .unwrap_or(true);
+        if worker_live {
+            let _ = Box::into_raw(owned);
+            return HS_STATUS_STATE;
+        }
+        drop(owned);
+        HS_STATUS_OK
+    }) {
+        Ok(code) => code,
+        Err(_) => HS_STATUS_PANIC,
+    }
+}
+
+/// Validate a peer id without touching a context.
+///
+/// `id` need not be NUL-terminated; `len` is the exact byte length.
+#[no_mangle]
+pub extern "C" fn hs_validate_peer_id(id: *const c_char, len: usize) -> u32 {
+    match catch_unwind(|| {
+        if id.is_null() {
+            return HS_STATUS_NULL;
+        }
+        if len > HS_MAX_PEER_ID_BYTES {
+            return HS_STATUS_INVALID;
+        }
+        // SAFETY: caller guarantees `id` points to `len` readable bytes.
+        let bytes = unsafe { std::slice::from_raw_parts(id as *const u8, len) };
+        match std::str::from_utf8(bytes) {
+            Err(_) => HS_STATUS_INVALID,
+            Ok(s) => match validate_peer_id(s) {
+                Ok(()) => HS_STATUS_OK,
+                Err(code) => code,
+            },
+        }
+    }) {
+        Ok(code) => code,
+        Err(_) => HS_STATUS_PANIC,
+    }
+}
+
+/// Explicitly construct the real inert [`Session`]`<`[`NativeHandler`]`>`.
+///
+/// This is the only call that moves `Created` → [`SessionState::Prepared`].
+/// Prepared means the session is owned and **inert**: no admission, no
+/// connection, no observation, no media, no hosting. It is **not**
+/// ready-to-view.
+///
+/// - Never calls `Session::initialize`, `io_loop`, `connect`, `start`,
+///   `core_main`, `start_server`, or any keyboard grab.
+/// - Never reads or writes config.
+/// - Calling twice is refused ([`HS_STATUS_STATE`]).
+/// - After [`hs_viewer_request_close`], prepare is refused
+///   ([`HS_STATUS_EXHAUSTED`]).
+#[no_mangle]
+pub extern "C" fn hs_viewer_prepare(ctx: *mut HsEngineCtx) -> u32 {
+    with_ctx(ctx, |c| {
+        let mut state = c.lock_state()?;
+        match *state {
+            SessionState::Created => {
+                let mut slot = c.lock_session()?;
+                if slot.is_some() {
+                    return Err(HS_STATUS_INTERNAL);
+                }
+                let session = inert_session();
+                // Start the bounded lifecycle delivery worker now so real
+                // callbacks execute. No networking/hosting/media is started.
+                let life = Arc::clone(&session.ui_handler.life);
+                let life_cv = Arc::clone(&session.ui_handler.life_cv);
+                let handle = spawn_life_worker(Arc::clone(&life), Arc::clone(&life_cv));
+                *slot = Some(session);
+                if let Ok(mut w) = c.inner.worker.lock() {
+                    *w = Some(handle);
+                }
+                if let Ok(mut l) = c.inner.life.lock() {
+                    *l = Some(life);
+                }
+                if let Ok(mut cv) = c.inner.life_cv.lock() {
+                    *cv = Some(life_cv);
+                }
+                *state = SessionState::Prepared;
+                Ok(HS_STATUS_OK)
+            }
+            SessionState::Prepared => Err(HS_STATUS_STATE),
+            SessionState::Closing | SessionState::Closed => Err(HS_STATUS_EXHAUSTED),
+        }
+    })
+}
+
+/// Read the current context state into `out_state`.
+///
+/// `out_state` receives the raw [`SessionState`] discriminant.
+#[no_mangle]
+pub extern "C" fn hs_viewer_state(ctx: *mut HsEngineCtx, out_state: *mut u32) -> u32 {
+    with_ctx(ctx, |c| {
+        if out_state.is_null() {
+            return Err(HS_STATUS_NULL);
+        }
+        let state = c.state()?;
+        // SAFETY: `out_state` is non-null caller storage for one u32.
+        unsafe {
+            *out_state = state as u32;
+        }
+        Ok(HS_STATUS_OK)
+    })
+}
+
+/// Request close. Drops the owned [`Session`] (real destructor runs) and moves
+/// to [`SessionState::Closing`].
+///
+/// The generation fence is bumped so late frames are disposed. On generation
+/// exhaustion this fails closed with [`HS_STATUS_EXHAUSTED`] and still
+/// cancels the delivery worker so drain can join it.
+///
+/// Idempotent once Closing. Refused ([`HS_STATUS_STATE`]) after Closed.
+/// **Safe to call from inside a lifecycle callback**: no lock is held across
+/// any worker wait (that is [`hs_viewer_drain`]'s job) and this call does not
+/// join the worker.
+///
+/// Atomicity: the `Created`/`Prepared` → `Closing`/`Closed` transition, the
+/// generation bump, and the exact session take happen under the initial state
+/// lock. Concurrent or re-entrant close therefore cannot bump the generation
+/// twice or enqueue a duplicate [`HS_LIFE_CLOSING`]. The real session
+/// destructor completes before any other thread can observe `Closing`, so
+/// drain cannot report quiescence mid-drop. Cancellation and the CLOSING
+/// signal run outside the state lock.
+#[no_mangle]
+pub extern "C" fn hs_viewer_request_close(ctx: *mut HsEngineCtx) -> u32 {
+    with_ctx(ctx, |c| {
+        // Transition under the initial state lock with an exact session take.
+        // The destructor runs before `Closing`/`Closed` is published.
+        let (handler, exhausted): (Option<NativeHandler>, bool) = {
+            let mut state = c.lock_state()?;
+            match *state {
+                SessionState::Created | SessionState::Prepared => {
+                    let exhausted = c.bump_generation().is_err();
+                    let session = c.lock_session()?.take();
+                    let handler = session.as_ref().map(|s| s.ui_handler.clone());
+                    // Drop before publishing the new state: drain may not
+                    // observe quiescence while the destructor is running.
+                    drop(session);
+                    *state = if exhausted {
+                        SessionState::Closed
+                    } else {
+                        SessionState::Closing
+                    };
+                    (handler, exhausted)
+                }
+                SessionState::Closing => return Ok(HS_STATUS_OK),
+                SessionState::Closed => return Err(HS_STATUS_STATE),
+            }
+        };
+
+        // Queue CLOSING and request cancellation outside the state lock so a
+        // callback-served delivery worker is never blocked on us. CLOSING is
+        // queued before `cancelled` so the worker still delivers it.
+        if let Some(h) = handler.as_ref() {
+            let gen = c.inner.generation.load(Ordering::SeqCst);
+            h.queue_life(HS_LIFE_CLOSING, gen);
+            if let Ok(mut q) = h.life.lock() {
+                q.cancelled = true;
+            }
+            h.life_cv.notify_all();
+        }
+
+        if exhausted {
+            // Terminal failure: refuse further work. The worker is still
+            // cancelled above; drain/free require the worker to finish.
+            return Err(HS_STATUS_EXHAUSTED);
+        }
+        Ok(HS_STATUS_OK)
+    })
+}
+
+/// Drain close work and move [`SessionState::Closing`] → [`SessionState::Closed`].
+///
+/// This drain is **asynchronous with respect to request-close**: it waits up
+/// to `timeout_ms` for outstanding lifecycle-delivery work to finish, then
+/// marks the context drained. A zero timeout performs a non-blocking check.
+///
+/// **The state lock is not held while waiting.** That makes
+/// [`hs_viewer_request_close`] from inside a lifecycle callback safe: the
+/// callback runs on the delivery worker with no lock held, calls
+/// request_close (which briefly takes and releases the state lock), and
+/// drain — which may be waiting on another thread — observes worker
+/// completion.
+///
+/// Returns:
+/// - [`HS_STATUS_OK`] when drained (or already Closed)
+/// - [`HS_STATUS_TIMEOUT`] when the deadline expired with work outstanding
+/// - [`HS_STATUS_STATE`] if not Closing/Closed
+#[no_mangle]
+pub extern "C" fn hs_viewer_drain(ctx: *mut HsEngineCtx, timeout_ms: u32) -> u32 {
+    with_ctx(ctx, |c| {
+        // Phase 1: validate state. Do NOT hold the lock across the wait.
+        {
+            let state = c.lock_state()?;
+            match *state {
+                SessionState::Closing | SessionState::Closed => {}
+                SessionState::Created | SessionState::Prepared => return Err(HS_STATUS_STATE),
+            }
+        }
+
+        let deadline = Instant::now() + Duration::from_millis(u64::from(timeout_ms));
+
+        // Phase 2: wait for pending events / in-flight callback / worker exit
+        // without holding the state lock. The worker invokes callbacks with no
+        // locks held, so a callback calling request_close can take the state
+        // lock without deadlocking against this wait.
+        //
+        // `worker_done` is set by the delivery worker when it observes
+        // cancellation and an empty queue. The JoinHandle is only taken in
+        // phase 3; handle presence alone is not "work outstanding".
+        loop {
+            let life_pending = {
+                let life = c.inner.life.lock().ok().and_then(|l| l.clone());
+                match life {
+                    Some(life) => life
+                        .lock()
+                        .map(|q| q.pending() > 0 || !q.worker_done)
+                        .unwrap_or(true),
+                    // No life queue: only the handle can indicate a live worker.
+                    None => c.inner.worker.lock().map(|w| w.is_some()).unwrap_or(true),
+                }
+            };
+            if !life_pending {
+                break;
+            }
+            if Instant::now() >= deadline {
+                return Err(HS_STATUS_TIMEOUT);
+            }
+            std::thread::sleep(Duration::from_millis(1));
+        }
+
+        // Phase 3: join the worker WITHOUT the state gate, then finalize.
+        // Joining under the state lock would deadlock a callback that
+        // re-enters request_close (it needs the state lock).
+        let handle = c.inner.worker.lock().ok().and_then(|mut w| w.take());
+        if let Some(handle) = handle {
+            let _ = handle.join();
+        }
+        let mut state = c.lock_state()?;
+        if *state != SessionState::Closed {
+            *state = SessionState::Closed;
+        }
+        Ok(HS_STATUS_OK)
+    })
+}
