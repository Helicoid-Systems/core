+
+/// Build a real [`Session`]`<`[`NativeHandler`]`>` with pure in-memory
+/// defaults. Does not read config, does not start network, does not hook
+/// input, does not acquire privileges.
+///
+/// The three server-side permission flags are initialized disabled
+/// (`false`) as actual `Session` fields.
+pub(crate) fn inert_session() -> Session<NativeHandler> {
+    Session {
+        password: String::new(),
+        args: Vec::new(),
+        lc: Arc::new(RwLock::new(LoginConfigHandler::inert_default())),
+        sender: Arc::new(RwLock::new(None)),
+        thread: Arc::new(Mutex::new(None)),
+        ui_handler: NativeHandler::default(),
+        server_keyboard_enabled: Arc::new(RwLock::new(false)),
+        server_file_transfer_enabled: Arc::new(RwLock::new(false)),
+        server_clipboard_enabled: Arc::new(RwLock::new(false)),
+        last_change_display: Arc::new(Mutex::new(ChangeDisplayRecord::default())),
+        connection_round_state: Arc::new(Mutex::new(ConnectionRoundState::default())),
+        printer_names: Arc::new(RwLock::new(Default::default())),
+        reconnect_count: Arc::new(std::sync::atomic::AtomicUsize::new(0)),
+        last_audit_note: Arc::new(Mutex::new(String::new())),
+        audit_guid: Arc::new(Mutex::new(String::new())),
+    }
+}
+
+struct CtxInner {
+    state: Mutex<SessionState>,
+    /// Real inert session. `Some` only while [`SessionState::Prepared`].
+    session: Mutex<Option<Session<NativeHandler>>>,
+    /// Incremented on every contained panic so the harness can observe it.
+    panics_contained: AtomicU32,
+    /// Generation fence. Exhaustion fails closed; it does not wrap.
+    generation: AtomicU32,
+}
+
+/// Opaque viewer/engine context. Owns at most one real [`Session`].
+pub struct HsEngineCtx {
+    inner: Arc<CtxInner>,
+}
+
+impl HsEngineCtx {
+    fn new() -> Self {
+        Self {
+            inner: Arc::new(CtxInner {
+                state: Mutex::new(SessionState::Created),
+                session: Mutex::new(None),
+                panics_contained: AtomicU32::new(0),
+                generation: AtomicU32::new(1),
+            }),
+        }
+    }
+
+    /// Lock the state. Poison fails closed: the caller gets [`HS_STATUS_INTERNAL`]
+    /// and must not proceed. There is no poisoned-mutex recovery that admits work.
+    fn lock_state(&self) -> Result<MutexGuard<'_, SessionState>, u32> {
+        self.inner.state.lock().map_err(|_| HS_STATUS_INTERNAL)
+    }
+
+    fn lock_session(&self) -> Result<MutexGuard<'_, Option<Session<NativeHandler>>>, u32> {
+        self.inner.session.lock().map_err(|_| HS_STATUS_INTERNAL)
+    }
+
+    fn state(&self) -> Result<SessionState, u32> {
+        Ok(*self.lock_state()?)
+    }
+
+    /// Bump the generation fence. On exhaustion return [`HS_STATUS_EXHAUSTED`]
+    /// and refuse further work. The counter never wraps.
+    fn bump_generation(&self) -> Result<u32, u32> {
+        self.inner
+            .generation
+            .try_update(Ordering::SeqCst, Ordering::SeqCst, |g| g.checked_add(1))
+            .map_err(|_| HS_STATUS_EXHAUSTED)
+    }
+}
+
+/// Validate a peer id: non-empty, ≤ [`HS_MAX_PEER_ID_BYTES`], no control chars.
+fn validate_peer_id(id: &str) -> Result<(), u32> {
+    if id.is_empty() {
+        return Err(HS_STATUS_INVALID);
+    }
+    if id.len() > HS_MAX_PEER_ID_BYTES {
+        return Err(HS_STATUS_INVALID);
+    }
+    if id.chars().any(|c| c.is_control()) {
+        return Err(HS_STATUS_INVALID);
+    }
+    Ok(())
+}
+
+/// Run `f` with Rust panic containment. On panic, bump the counter and return
+/// PANIC.
+///
+/// This does **not** catch undefined behaviour. Invalid pointers, use-after-free,
+/// and data races are not converted into [`HS_STATUS_PANIC`]; they are still UB.
+fn contain<T>(ctx: Option<&HsEngineCtx>, f: impl FnOnce() -> Result<T, u32>) -> Result<T, u32> {
+    match catch_unwind(AssertUnwindSafe(f)) {
+        Ok(r) => r,
+        Err(_) => {
+            if let Some(ctx) = ctx {
+                let _ = ctx.inner.panics_contained.try_update(
+                    Ordering::SeqCst,
+                    Ordering::SeqCst,
+                    |n| Some(n.saturating_add(1)),
+                );
+            }
+            Err(HS_STATUS_PANIC)
+        }
+    }
+}
+
+fn with_ctx<'a>(ctx: *mut HsEngineCtx, f: impl FnOnce(&'a HsEngineCtx) -> Result<u32, u32>) -> u32 {
+    if ctx.is_null() {
+        return HS_STATUS_NULL;
+    }
+    // SAFETY CONTRACT (caller):
+    //  - `ctx` must be a live pointer produced by `hs_engine_ctx_new`.
+    //  - The pointer must not be used after `hs_engine_ctx_free`.
+    //  - Calls on the same context must not be re-entered concurrently.
+    // Violating any of these is undefined behaviour; `catch_unwind` does not
+    // rescue it.
+    let ctx_ref = unsafe { &*ctx };
+    match contain(Some(ctx_ref), move || f(ctx_ref)) {
+        Ok(code) => code,
+        Err(code) => code,
+    }
+}
+
+/// Stable C string storage for [`hs_engine_version`] (no per-call leak).
+static VERSION_C: OnceLock<CString> = OnceLock::new();
+
+/// Return the ABI version compiled into this library.
+#[no_mangle]
+pub extern "C" fn hs_abi_version() -> u32 {
+    HS_ABI_VERSION
+}
+
+/// Return the engine version string (static storage, never freed, no leak).
+///
+/// The pointer remains valid for the process lifetime. Do not free it. Returns
+/// null on failure.
+#[no_mangle]
+pub extern "C" fn hs_engine_version() -> *const c_char {
+    match catch_unwind(|| {
+        VERSION_C.get_or_init(|| CString::new(crate::version::VERSION).unwrap_or_default())
+    }) {
+        Ok(s) => s.as_ptr(),
+        Err(_) => std::ptr::null(),
+    }
+}
+
+/// Construct a new engine context. Does **not** construct the [`Session`] yet.
+///
+/// `out` receives an opaque pointer. Caller must free with
+/// [`hs_engine_ctx_free`] exactly once. A null `out` is rejected.
+///
+/// Prerequisites: `out` must be non-null and point to writable pointer-sized
+/// storage. These functions do not detect double-free.
+#[no_mangle]
+pub extern "C" fn hs_engine_ctx_new(out: *mut *mut HsEngineCtx) -> u32 {
+    match catch_unwind(|| {
+        if out.is_null() {
+            return HS_STATUS_NULL;
+        }
+        let ctx = HsEngineCtx::new();
+        // SAFETY: `out` is non-null caller-provided storage for one pointer.
+        unsafe {
+            *out = Box::into_raw(Box::new(ctx));
+        }
+        HS_STATUS_OK
+    }) {
+        Ok(code) => code,
+        Err(_) => HS_STATUS_PANIC,
+    }
+}
+
+/// Free a context. Null is accepted and ignored.
+///
+/// If the context still owns a [`Session`], it is dropped here.
+///
+/// Prerequisites (not checked; violating them is UB):
+///  - `ctx` must come from [`hs_engine_ctx_new`] and not have been freed.
+///  - No other call on this context may be in progress.
+///  - The pointer must not be used afterwards.
+///
+/// This function does **not** detect double-free. A double-free is undefined
+/// behaviour; it is not converted into a status code.
+#[no_mangle]
+pub extern "C" fn hs_engine_ctx_free(ctx: *mut HsEngineCtx) -> u32 {
+    match catch_unwind(|| {
+        if ctx.is_null() {
+            return HS_STATUS_OK;
+        }
+        // SAFETY: pointer came from hs_engine_ctx_new and has not been freed.
+        drop(unsafe { Box::from_raw(ctx) });
+        HS_STATUS_OK
+    }) {
+        Ok(code) => code,
+        Err(_) => HS_STATUS_PANIC,
+    }
+}
+
+/// Validate a peer id without touching a context.
+///
+/// `id` need not be NUL-terminated; `len` is the exact byte length.
+#[no_mangle]
+pub extern "C" fn hs_validate_peer_id(id: *const c_char, len: usize) -> u32 {
+    match catch_unwind(|| {
+        if id.is_null() {
+            return HS_STATUS_NULL;
+        }
+        if len > HS_MAX_PEER_ID_BYTES {
+            return HS_STATUS_INVALID;
+        }
+        // SAFETY: caller guarantees `id` points to `len` readable bytes.
+        let bytes = unsafe { std::slice::from_raw_parts(id as *const u8, len) };
+        match std::str::from_utf8(bytes) {
+            Err(_) => HS_STATUS_INVALID,
+            Ok(s) => match validate_peer_id(s) {
+                Ok(()) => HS_STATUS_OK,
+                Err(code) => code,
+            },
+        }
+    }) {
+        Ok(code) => code,
+        Err(_) => HS_STATUS_PANIC,
+    }
+}
+
+/// Explicitly construct the real inert [`Session`]`<`[`NativeHandler`]`>`.
+///
+/// This is the only call that moves `Created` → [`SessionState::Prepared`].
+/// Prepared means the session is owned and **inert**: no admission, no
+/// connection, no observation, no media, no hosting. It is **not**
+/// ready-to-view.
+///
+/// - Never calls `Session::initialize`, `io_loop`, `connect`, `start`,
+///   `core_main`, `start_server`, or any keyboard grab.
+/// - Never reads or writes config.
+/// - Calling twice is refused ([`HS_STATUS_STATE`]).
+/// - After [`hs_viewer_request_close`], prepare is refused
+///   ([`HS_STATUS_EXHAUSTED`]).
+#[no_mangle]
+pub extern "C" fn hs_viewer_prepare(ctx: *mut HsEngineCtx) -> u32 {
+    with_ctx(ctx, |c| {
+        let mut state = c.lock_state()?;
+        match *state {
+            SessionState::Created => {
+                let mut slot = c.lock_session()?;
+                if slot.is_some() {
+                    return Err(HS_STATUS_INTERNAL);
+                }
+                *slot = Some(inert_session());
+                *state = SessionState::Prepared;
+                Ok(HS_STATUS_OK)
+            }
+            SessionState::Prepared => Err(HS_STATUS_STATE),
+            SessionState::Closing | SessionState::Closed => Err(HS_STATUS_EXHAUSTED),
+        }
+    })
+}
+
+/// Read the current context state into `out_state`.
+///
+/// `out_state` receives the raw [`SessionState`] discriminant.
+#[no_mangle]
+pub extern "C" fn hs_viewer_state(ctx: *mut HsEngineCtx, out_state: *mut u32) -> u32 {
+    with_ctx(ctx, |c| {
+        if out_state.is_null() {
+            return Err(HS_STATUS_NULL);
+        }
+        let state = c.state()?;
+        // SAFETY: `out_state` is non-null caller storage for one u32.
+        unsafe {
+            *out_state = state as u32;
+        }
+        Ok(HS_STATUS_OK)
+    })
+}
+
+/// Request close. Drops the owned [`Session`] (real destructor runs) and moves
+/// to [`SessionState::Closing`].
+///
+/// The generation fence is bumped. On generation exhaustion this fails closed
+/// with [`HS_STATUS_EXHAUSTED`] and does **not** admit further work.
+///
+/// Idempotent once Closing. Refused ([`HS_STATUS_STATE`]) after Closed.
+#[no_mangle]
+pub extern "C" fn hs_viewer_request_close(ctx: *mut HsEngineCtx) -> u32 {
+    with_ctx(ctx, |c| {
+        let mut state = c.lock_state()?;
+        match *state {
+            SessionState::Created | SessionState::Prepared => {
+                // Teardown still drops the owned Session when the fence is exhausted.
+                // No replacement work is admitted after this terminal failure.
+                if let Err(code) = c.bump_generation() {
+                    *c.lock_session()? = None;
+                    *state = SessionState::Closed;
+                    return Err(code);
+                }
+                {
+                    let mut slot = c.lock_session()?;
+                    // Real drop of Session<NativeHandler>, if any.
+                    *slot = None;
+                }
+                *state = SessionState::Closing;
+                Ok(HS_STATUS_OK)
+            }
+            SessionState::Closing => Ok(HS_STATUS_OK),
+            SessionState::Closed => Err(HS_STATUS_STATE),
+        }
+    })
+}
+
+/// Drain close work and move [`SessionState::Closing`] → [`SessionState::Closed`].
+///
+/// **This drain is synchronous.** It spawns no worker, registers no callback,
+/// and performs no blocking I/O. It is **not** an asynchronous cancellation
+/// proof. `timeout_ms` is reserved and ignored.
+///
+/// Returns [`HS_STATUS_STATE`] if not Closing. Idempotent when Closed.
+#[no_mangle]
+pub extern "C" fn hs_viewer_drain(ctx: *mut HsEngineCtx, timeout_ms: u32) -> u32 {
+    with_ctx(ctx, |c| {
+        let _ = timeout_ms;
+        let mut state = c.lock_state()?;
+        match *state {
+            SessionState::Closing => {
+                *state = SessionState::Closed;
+                Ok(HS_STATUS_OK)
+            }
+            SessionState::Closed => Ok(HS_STATUS_OK),
+            SessionState::Created | SessionState::Prepared => Err(HS_STATUS_STATE),
+        }
+    })
+}
+
+/// Report how many Rust panics have been contained on this context.
+///
+/// Counts panics only. Does not count or detect undefined behaviour.
+#[no_mangle]
+pub extern "C" fn hs_panics_contained(ctx: *mut HsEngineCtx, out_count: *mut u32) -> u32 {
+    with_ctx(ctx, |c| {
+        if out_count.is_null() {
+            return Err(HS_STATUS_NULL);
+        }
+        let n = c.inner.panics_contained.load(Ordering::SeqCst);
+        // SAFETY: `out_count` is non-null caller storage for one u32.
+        unsafe {
+            *out_count = n;
+        }
+        Ok(HS_STATUS_OK)
+    })
+}
+
+/// Deliberately panic inside the ABI boundary to prove Rust panic containment.
+///
+/// The process must survive; the call returns [`HS_STATUS_PANIC`]. This is a
+/// laboratory proof hook only. It does **not** prove UB is contained.
+#[no_mangle]
+pub extern "C" fn hs_debug_inject_panic(ctx: *mut HsEngineCtx) -> u32 {
+    with_ctx(ctx, |_c| {
+        panic!("hs_native: deliberate ABI panic-containment probe");
+    })
+}
+
+/// Return the generation fence value.
+#[no_mangle]
+pub extern "C" fn hs_generation(ctx: *mut HsEngineCtx, out_gen: *mut u32) -> u32 {
+    with_ctx(ctx, |c| {
+        if out_gen.is_null() {
+            return Err(HS_STATUS_NULL);
+        }
+        let g = c.inner.generation.load(Ordering::SeqCst);
+        // SAFETY: `out_gen` is non-null caller storage for one u32.
+        unsafe {
+            *out_gen = g;
+        }
+        Ok(HS_STATUS_OK)
+    })
+}
+
+/// Read `Session.server_keyboard_enabled` from the real owned session field.
+///
+/// Requires [`SessionState::Prepared`]. `out_enabled` receives 0 or 1.
+#[no_mangle]
+pub extern "C" fn hs_server_keyboard_enabled(ctx: *mut HsEngineCtx, out_enabled: *mut u32) -> u32 {
+    with_ctx(ctx, |c| {
+        read_perm_flag(c, out_enabled, |s| {
+            s.server_keyboard_enabled
+                .read()
+                .map(|v| *v)
+                .map_err(|_| HS_STATUS_INTERNAL)
+        })
+    })
+}
+
+/// Read `Session.server_file_transfer_enabled` from the real owned session field.
+///
+/// Requires [`SessionState::Prepared`]. `out_enabled` receives 0 or 1.
+#[no_mangle]
+pub extern "C" fn hs_server_file_transfer_enabled(
+    ctx: *mut HsEngineCtx,
+    out_enabled: *mut u32,
+) -> u32 {
+    with_ctx(ctx, |c| {
+        read_perm_flag(c, out_enabled, |s| {
+            s.server_file_transfer_enabled
+                .read()
+                .map(|v| *v)
+                .map_err(|_| HS_STATUS_INTERNAL)
+        })
+    })
+}
+
+/// Read `Session.server_clipboard_enabled` from the real owned session field.
+///
+/// Requires [`SessionState::Prepared`]. `out_enabled` receives 0 or 1.
+#[no_mangle]
+pub extern "C" fn hs_server_clipboard_enabled(ctx: *mut HsEngineCtx, out_enabled: *mut u32) -> u32 {
+    with_ctx(ctx, |c| {
+        read_perm_flag(c, out_enabled, |s| {
+            s.server_clipboard_enabled
+                .read()
+                .map(|v| *v)
+                .map_err(|_| HS_STATUS_INTERNAL)
+        })
+    })
+}
+
+fn read_perm_flag(
+    c: &HsEngineCtx,
+    out_enabled: *mut u32,
+    read: impl FnOnce(&Session<NativeHandler>) -> Result<bool, u32>,
+) -> Result<u32, u32> {
+    if out_enabled.is_null() {
+        return Err(HS_STATUS_NULL);
+    }
+    if c.state()? != SessionState::Prepared {
+        return Err(HS_STATUS_STATE);
+    }
+    let slot = c.lock_session()?;
+    let session = slot.as_ref().ok_or(HS_STATUS_INTERNAL)?;
+    let enabled = read(session)? as u32;
+    // SAFETY: `out_enabled` is non-null caller storage for one u32.
+    unsafe {
+        *out_enabled = enabled;
+    }
+    Ok(HS_STATUS_OK)
+}
+
+/// Ask the real [`NativeHandler`] for an RGBA pointer. Always null.
+///
+/// Proves the live handler never fabricates a media buffer. `out_ptr`
+/// receives null on success. Requires [`SessionState::Prepared`].
+#[no_mangle]
+pub extern "C" fn hs_handler_rgba_ptr(
+    ctx: *mut HsEngineCtx,
+    display: u32,
+    out_ptr: *mut *const u8,
+) -> u32 {
+    with_ctx(ctx, |c| {
+        if out_ptr.is_null() {
+            return Err(HS_STATUS_NULL);
+        }
+        if c.state()? != SessionState::Prepared {
+            return Err(HS_STATUS_STATE);
+        }
+        let slot = c.lock_session()?;
+        let session = slot.as_ref().ok_or(HS_STATUS_INTERNAL)?;
+        let p = session.ui_handler.get_rgba(display as usize);
+        // SAFETY: `out_ptr` is non-null caller storage for one pointer.
+        unsafe {
+            *out_ptr = p;
+        }
+        Ok(HS_STATUS_OK)
+    })
+}
+
+/// Begin connecting to a peer. **Not available before B03.**
+///
+/// Always returns [`HS_STATUS_UNAVAILABLE`]. No network work is started.
+#[no_mangle]
+pub extern "C" fn hs_viewer_connect(
+    ctx: *mut HsEngineCtx,
+    peer_id: *const c_char,
+    peer_id_len: usize,
+) -> u32 {
+    with_ctx(ctx, |_c| {
+        let _ = (peer_id, peer_id_len);
+        Err(HS_STATUS_UNAVAILABLE)
+    })
+}
+
+/// Begin observation of a remote display. **Not available before B03.**
+///
+/// Always returns [`HS_STATUS_UNAVAILABLE`]. No stream is created.
+#[no_mangle]
+pub extern "C" fn hs_viewer_begin_observation(
+    ctx: *mut HsEngineCtx,
+    display: u32,
+    out_stream: *mut u32,
+) -> u32 {
+    with_ctx(ctx, |_c| {
+        let _ = (display, out_stream);
+        Err(HS_STATUS_UNAVAILABLE)
+    })
+}
