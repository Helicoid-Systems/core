+/// Validate a peer id: non-empty, ≤ [`HS_MAX_PEER_ID_BYTES`], no control chars.
+fn validate_peer_id(id: &str) -> Result<(), u32> {
+    if id.is_empty() {
+        return Err(HS_STATUS_INVALID);
+    }
+    if id.len() > HS_MAX_PEER_ID_BYTES {
+        return Err(HS_STATUS_INVALID);
+    }
+    if id.chars().any(|c| c.is_control()) {
+        return Err(HS_STATUS_INVALID);
+    }
+    Ok(())
+}
+
+/// Run `f` with Rust panic containment. On panic, bump the counter and return
+/// PANIC.
+///
+/// This does **not** catch undefined behaviour. Invalid pointers, use-after-free,
+/// and data races are not converted into [`HS_STATUS_PANIC`]; they are still UB.
+fn contain<T>(ctx: Option<&HsEngineCtx>, f: impl FnOnce() -> Result<T, u32>) -> Result<T, u32> {
+    match catch_unwind(AssertUnwindSafe(f)) {
+        Ok(r) => r,
+        Err(_) => {
+            if let Some(ctx) = ctx {
+                let _ = ctx.inner.panics_contained.try_update(
+                    Ordering::SeqCst,
+                    Ordering::SeqCst,
+                    |n| Some(n.saturating_add(1)),
+                );
+            }
+            Err(HS_STATUS_PANIC)
+        }
+    }
+}
+
+fn with_ctx<'a>(ctx: *mut HsEngineCtx, f: impl FnOnce(&'a HsEngineCtx) -> Result<u32, u32>) -> u32 {
+    if ctx.is_null() {
+        return HS_STATUS_NULL;
+    }
+    // SAFETY CONTRACT (caller):
+    //  - `ctx` must be a live pointer produced by `hs_engine_ctx_new`.
+    //  - The pointer must not be used after `hs_engine_ctx_free`.
+    //  - Calls on the same context must not be re-entered concurrently.
+    // Violating any of these is undefined behaviour; `catch_unwind` does not
+    // rescue it.
+    let ctx_ref = unsafe { &*ctx };
+    match contain(Some(ctx_ref), move || f(ctx_ref)) {
+        Ok(code) => code,
+        Err(code) => code,
+    }
+}
