+/// Report how many Rust panics have been contained on this context.
+///
+/// Counts panics only. Does not count or detect undefined behaviour.
+#[no_mangle]
+pub extern "C" fn hs_panics_contained(ctx: *mut HsEngineCtx, out_count: *mut u32) -> u32 {
+    with_ctx(ctx, |c| {
+        if out_count.is_null() {
+            return Err(HS_STATUS_NULL);
+        }
+        let n = c.inner.panics_contained.load(Ordering::SeqCst);
+        // SAFETY: `out_count` is non-null caller storage for one u32.
+        unsafe {
+            *out_count = n;
+        }
+        Ok(HS_STATUS_OK)
+    })
+}
