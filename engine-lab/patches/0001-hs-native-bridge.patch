+    /// Registration racing close/drain: a foreign root is never accepted after
+    /// Closing. Either the call is refused with STATE, or it was accepted while
+    /// still Prepared (before the close transition).
+    #[test]
+    fn register_racing_close_drain_never_publishes_after_close() {
+        use std::sync::atomic::{AtomicUsize, Ordering as AO};
+        extern "C" fn cb(_u: *mut c_void, _c: u32, _g: u32) {}
+
+        let accepted = AtomicUsize::new(0);
+        let refused = AtomicUsize::new(0);
+
+        for _ in 0..16 {
+            let out = Box::into_raw(Box::new(HsEngineCtx::new()));
+            assert_eq!(hs_viewer_prepare(out), HS_STATUS_OK);
+            let reg = out as usize;
+            let close = out as usize;
+            let r = std::thread::spawn(move || {
+                let out = reg as *mut HsEngineCtx;
+                hs_viewer_set_lifecycle_cb(out, Some(cb), std::ptr::null_mut())
+            });
+            let c = std::thread::spawn(move || {
+                let out = close as *mut HsEngineCtx;
+                let st = hs_viewer_request_close(out);
+                let _ = hs_viewer_drain(out, 1000);
+                st
+            });
+            let reg_st = r.join().unwrap();
+            let close_st = c.join().unwrap();
+            assert_eq!(close_st, HS_STATUS_OK);
+            match reg_st {
+                HS_STATUS_OK => {
+                    accepted.fetch_add(1, AO::SeqCst);
+                    // Accepted only possible while still Prepared; drain already
+                    // completed, so no further root publication can occur.
+                }
+                HS_STATUS_STATE => {
+                    refused.fetch_add(1, AO::SeqCst);
+                }
+                other => panic!("unexpected registration status {other}"),
+            }
+            // After close+drain, registration is always refused.
+            assert_eq!(
+                hs_viewer_set_lifecycle_cb(out, Some(cb), std::ptr::null_mut()),
+                HS_STATUS_STATE
+            );
+            assert_eq!(hs_engine_ctx_free(out), HS_STATUS_OK);
+        }
+        // Sanity: both outcomes exercised at least the refusal path is real.
+        assert!(refused.load(AO::SeqCst) + accepted.load(AO::SeqCst) == 16);
+    }
+
+    /// Polling mode: with no callback registered the worker must NOT consume
+    /// (and silently discard) queued events. `hs_viewer_poll_life` retains them.
+    #[test]
+    fn polling_mode_retains_events_under_worker_scheduling() {
+        let out = Box::into_raw(Box::new(HsEngineCtx::new()));
+        assert_eq!(hs_viewer_prepare(out), HS_STATUS_OK);
+        // No callback registered. Queue several events while the worker runs.
+        for i in 0..4u32 {
+            assert_eq!(hs_debug_queue_life(out, HS_LIFE_FRAME_READY, i + 1), HS_STATUS_OK);
+        }
+        // Give the worker time to (incorrectly) consume events if it would.
+        std::thread::sleep(Duration::from_millis(50));
+        // Every event must still be pollable.
+        for i in 0..4u32 {
+            let mut code = 0u32;
+            let mut gen = 0u32;
+            assert_eq!(
+                hs_viewer_poll_life(out, &mut code, &mut gen),
+                HS_STATUS_OK,
+                "polling event {} retained under worker scheduling",
+                i
+            );
+            assert_eq!(code, HS_LIFE_FRAME_READY);
+            assert_eq!(gen, i + 1);
+        }
+        // Queue is empty now.
+        let mut code = 0u32;
+        let mut gen = 0u32;
+        assert_eq!(hs_viewer_poll_life(out, &mut code, &mut gen), HS_STATUS_STATE);
+
+        // Close/drain with leftover poll-mode events must not hang the worker.
+        assert_eq!(hs_debug_queue_life(out, HS_LIFE_FRAME_READY, 99), HS_STATUS_OK);
+        assert_eq!(hs_viewer_request_close(out), HS_STATUS_OK);
+        assert_eq!(hs_viewer_drain(out, 1000), HS_STATUS_OK);
+        assert_eq!(hs_engine_ctx_free(out), HS_STATUS_OK);
+    }
+
+    /// Callback mode and poll mode: once a callback is registered it consumes
+    /// events; clearing it returns the queue to poll retention.
+    #[test]
+    fn callback_and_poll_modes_hand_off_cleanly() {
+        use std::sync::atomic::AtomicUsize;
+        static CALLS: AtomicUsize = AtomicUsize::new(0);
+        extern "C" fn cb(_u: *mut c_void, _c: u32, _g: u32) {
+            CALLS.fetch_add(1, Ordering::SeqCst);
+        }
+
+        let out = Box::into_raw(Box::new(HsEngineCtx::new()));
+        assert_eq!(hs_viewer_prepare(out), HS_STATUS_OK);
+        assert_eq!(
+            hs_viewer_set_lifecycle_cb(out, Some(cb), std::ptr::null_mut()),
+            HS_STATUS_OK
+        );
+        assert_eq!(hs_debug_queue_life(out, HS_LIFE_FRAME_READY, 1), HS_STATUS_OK);
+        // Callback consumes the event.
+        let deadline = Instant::now() + Duration::from_millis(500);
+        while CALLS.load(Ordering::SeqCst) == 0 && Instant::now() < deadline {
+            std::thread::sleep(Duration::from_millis(1));
+        }
+        assert_eq!(CALLS.load(Ordering::SeqCst), 1, "callback consumed the event");
+        // Clear the callback: further events are retained for polling.
+        assert_eq!(
+            hs_viewer_set_lifecycle_cb(out, None, std::ptr::null_mut()),
+            HS_STATUS_OK
+        );
+        assert_eq!(hs_debug_queue_life(out, HS_LIFE_FRAME_READY, 2), HS_STATUS_OK);
+        std::thread::sleep(Duration::from_millis(50));
+        let mut code = 0u32;
+        let mut gen = 0u32;
+        assert_eq!(hs_viewer_poll_life(out, &mut code, &mut gen), HS_STATUS_OK);
+        assert_eq!(gen, 2, "cleared callback leaves events for poll");
+        assert_eq!(hs_viewer_request_close(out), HS_STATUS_OK);
+        assert_eq!(hs_viewer_drain(out, 1000), HS_STATUS_OK);
+        assert_eq!(hs_engine_ctx_free(out), HS_STATUS_OK);
+    }
+
+    /// Close racing prepare: prepare after close is refused; concurrent
+    /// prepare+close ends in a consistent terminal state.
+    #[test]
+    fn close_racing_prepare_is_consistent() {
+        for _ in 0..8 {
+            let out = Box::into_raw(Box::new(HsEngineCtx::new()));
+            let p = out as usize;
+            let c = out as usize;
+            let prep = std::thread::spawn(move || hs_viewer_prepare(p as *mut HsEngineCtx));
+            let close = std::thread::spawn(move || hs_viewer_request_close(c as *mut HsEngineCtx));
+            let pst = prep.join().unwrap();
+            let cst = close.join().unwrap();
+            // Close is OK or State (if it somehow saw Closed); prepare is OK or
+            // State/Exhausted. Exactly one of the two owns the transition.
+            assert!(cst == HS_STATUS_OK || cst == HS_STATUS_STATE || cst == HS_STATUS_EXHAUSTED);
+            assert!(pst == HS_STATUS_OK || pst == HS_STATUS_STATE || pst == HS_STATUS_EXHAUSTED);
+            let mut state = u32::MAX;
+            assert_eq!(hs_viewer_state(out, &mut state), HS_STATUS_OK);
+            // Terminal path: drain then free must succeed.
+            if state == SessionState::Created as u32 {
+                // Close lost the race entirely (prepare won and close saw
+                // Created? impossible after our fix — close always transitions).
+                // Either way drain of a never-prepared context is STATE.
+                assert_eq!(hs_viewer_drain(out, 100), HS_STATUS_STATE);
+            } else {
+                let _ = hs_viewer_drain(out, 1000);
+            }
+            assert_eq!(hs_engine_ctx_free(out), HS_STATUS_OK);
+        }
+    }
+}

