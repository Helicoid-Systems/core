+// ---------------------------------------------------------------------------
+// Tests: real Session construct/drop and disabled permission defaults.
+// ---------------------------------------------------------------------------
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn peer_id_bounds() {
+        assert!(validate_peer_id("").is_err());
+        assert!(validate_peer_id("ok").is_ok());
+        assert!(validate_peer_id(&"x".repeat(HS_MAX_PEER_ID_BYTES + 1)).is_err());
+        assert!(validate_peer_id("a\u{0}b").is_err());
+    }
+
+    #[test]
+    fn inert_session_construct_drop_and_disabled_perms() {
+        // Real Session<NativeHandler>, real LoginConfigHandler fields,
+        // no config read (inert_default), then a real drop.
+        let session = inert_session();
+        assert!(!*session.server_keyboard_enabled.read().unwrap());
+        assert!(!*session.server_file_transfer_enabled.read().unwrap());
+        assert!(!*session.server_clipboard_enabled.read().unwrap());
+        // Default conn type is DEFAULT_CONN; no connection exists.
+        assert!(session.is_default());
+        drop(session);
+    }
+
+    #[test]
+    fn native_handler_get_rgba_is_null_and_never_publishes() {
+        let h = NativeHandler::default();
+        assert!(h.get_rgba(0).is_null());
+        assert!(h.get_rgba(1).is_null());
+        // Callbacks are refused (counted), never published.
+        h.on_connected(ConnType::DEFAULT_CONN);
+        h.set_permission("keyboard", true);
+        assert!(h.refused_count() >= 3);
+    }
+
+    #[test]
+    fn prepare_constructs_real_session_and_reports_disabled_perms() {
+        let mut out: *mut HsEngineCtx = std::ptr::null_mut();
+        assert_eq!(hs_engine_ctx_new(&mut out), HS_STATUS_OK);
+        let mut state = u32::MAX;
+        assert_eq!(hs_viewer_state(out, &mut state), HS_STATUS_OK);
+        assert_eq!(state, SessionState::Created as u32);
+
+        assert_eq!(hs_viewer_prepare(out), HS_STATUS_OK);
+        assert_eq!(hs_viewer_state(out, &mut state), HS_STATUS_OK);
+        assert_eq!(state, SessionState::Prepared as u32);
+        // Second prepare refused.
+        assert_eq!(hs_viewer_prepare(out), HS_STATUS_STATE);
+
+        let mut flag = u32::MAX;
+        assert_eq!(hs_server_keyboard_enabled(out, &mut flag), HS_STATUS_OK);
+        assert_eq!(flag, 0);
+        assert_eq!(
+            hs_server_file_transfer_enabled(out, &mut flag),
+            HS_STATUS_OK
+        );
+        assert_eq!(flag, 0);
+        assert_eq!(hs_server_clipboard_enabled(out, &mut flag), HS_STATUS_OK);
+        assert_eq!(flag, 0);
+
+        // Handler never fabricates media.
+        let mut p: *const u8 = std::ptr::dangling();
+        assert_eq!(hs_handler_rgba_ptr(out, 0, &mut p), HS_STATUS_OK);
+        assert!(p.is_null());
+
+        // Connecting / observation are unavailable before B03.
+        let id = b"peer-1";
+        assert_eq!(
+            hs_viewer_connect(out, id.as_ptr() as *const c_char, id.len()),
+            HS_STATUS_UNAVAILABLE
+        );
+        let mut stream = u32::MAX;
+        assert_eq!(
+            hs_viewer_begin_observation(out, 0, &mut stream),
+            HS_STATUS_UNAVAILABLE
+        );
+
+        // Close drops the real session.
+        assert_eq!(hs_viewer_request_close(out), HS_STATUS_OK);
+        assert_eq!(hs_viewer_state(out, &mut state), HS_STATUS_OK);
+        assert_eq!(state, SessionState::Closing as u32);
+        // Permission reads require Prepared.
+        assert_eq!(hs_server_keyboard_enabled(out, &mut flag), HS_STATUS_STATE);
+        assert_eq!(hs_viewer_drain(out, 0), HS_STATUS_OK);
+        assert_eq!(hs_viewer_state(out, &mut state), HS_STATUS_OK);
+        assert_eq!(state, SessionState::Closed as u32);
+        assert_eq!(hs_engine_ctx_free(out), HS_STATUS_OK);
+    }
+
+    #[test]
+    fn explicit_prepare_does_not_start_hosting() {
+        // State machine only here; the C harness checks process-local LISTEN
+        // sockets around prepare (with `lsof -a`, process-local).
+        let mut out: *mut HsEngineCtx = std::ptr::null_mut();
+        hs_engine_ctx_new(&mut out);
+        assert_eq!(hs_viewer_prepare(out), HS_STATUS_OK);
+        let mut state = u32::MAX;
+        hs_viewer_state(out, &mut state);
+        assert_eq!(state, SessionState::Prepared as u32);
+        hs_engine_ctx_free(out);
+    }
+
+    #[test]
+    fn panic_is_contained() {
+        let mut out: *mut HsEngineCtx = std::ptr::null_mut();
+        hs_engine_ctx_new(&mut out);
+        assert_eq!(hs_debug_inject_panic(out), HS_STATUS_PANIC);
+        let mut n = 0;
+        assert_eq!(hs_panics_contained(out, &mut n), HS_STATUS_OK);
+        assert_eq!(n, 1);
+        hs_engine_ctx_free(out);
+    }
+
+    #[test]
+    fn generation_exhaustion_fails_closed() {
+        let ctx = HsEngineCtx::new();
+        // Force the fence to its maximum, then require fail-closed behaviour.
+        ctx.inner.generation.store(u32::MAX, Ordering::SeqCst);
+        assert_eq!(ctx.bump_generation(), Err(HS_STATUS_EXHAUSTED));
+        // A close after exhaustion is terminal and still tears down owned state.
+        let ctx = HsEngineCtx::new();
+        ctx.inner.generation.store(u32::MAX, Ordering::SeqCst);
+        let boxed = Box::into_raw(Box::new(ctx));
+        assert_eq!(hs_viewer_request_close(boxed), HS_STATUS_EXHAUSTED);
+        let mut state = u32::MAX;
+        assert_eq!(hs_viewer_state(boxed, &mut state), HS_STATUS_OK);
+        assert_eq!(state, SessionState::Closed as u32);
+        assert_eq!(hs_viewer_prepare(boxed), HS_STATUS_EXHAUSTED);
+        assert_eq!(hs_engine_ctx_free(boxed), HS_STATUS_OK);
+    }
+
+    #[test]
+    fn exhausted_close_still_drops_prepared_session() {
+        let out = Box::into_raw(Box::new(HsEngineCtx::new()));
+        assert_eq!(hs_viewer_prepare(out), HS_STATUS_OK);
+        let ctx = unsafe { &*out };
+        ctx.inner.generation.store(u32::MAX, Ordering::SeqCst);
+        assert_eq!(hs_viewer_request_close(out), HS_STATUS_EXHAUSTED);
+        assert!(ctx.lock_session().unwrap().is_none());
+        assert_eq!(ctx.state().unwrap(), SessionState::Closed);
+        assert_eq!(hs_viewer_prepare(out), HS_STATUS_EXHAUSTED);
+        assert_eq!(hs_engine_ctx_free(out), HS_STATUS_OK);
+    }
+
+    #[test]
+    fn poisoned_state_mutex_fails_closed() {
+        let ctx = HsEngineCtx::new();
+        // Poison the lock: panic while holding the guard.
+        let _ = catch_unwind(AssertUnwindSafe(|| {
+            let _g = ctx.inner.state.lock().unwrap();
+            panic!("poison probe");
+        }));
+        // After poison, state reads must fail closed (INTERNAL), not recover
+        // into admitting work.
+        assert_eq!(ctx.lock_state().err(), Some(HS_STATUS_INTERNAL));
+        assert_eq!(ctx.state(), Err(HS_STATUS_INTERNAL));
+    }
+}
