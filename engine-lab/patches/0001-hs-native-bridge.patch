+    /// Callback replacement retires the previous root; the old root is not
+    /// freed until drain (no UAF for an in-flight old callback).
+    #[test]
+    fn callback_replacement_retires_root_until_drain() {
+        use std::sync::atomic::AtomicUsize;
+        static OLD_CALLS: AtomicUsize = AtomicUsize::new(0);
+        static NEW_CALLS: AtomicUsize = AtomicUsize::new(0);
+
+        extern "C" fn old_cb(_user: *mut c_void, _code: u32, _gen: u32) {
+            OLD_CALLS.fetch_add(1, Ordering::SeqCst);
+        }
+        extern "C" fn new_cb(_user: *mut c_void, _code: u32, _gen: u32) {
+            NEW_CALLS.fetch_add(1, Ordering::SeqCst);
+        }
+
+        let out = Box::into_raw(Box::new(HsEngineCtx::new()));
+        assert_eq!(hs_viewer_prepare(out), HS_STATUS_OK);
+        assert_eq!(
+            hs_viewer_set_lifecycle_cb(out, Some(old_cb), std::ptr::null_mut()),
+            HS_STATUS_OK
+        );
+        // Replace: the previous root must be retired, not dropped.
+        assert_eq!(
+            hs_viewer_set_lifecycle_cb(out, Some(new_cb), std::ptr::null_mut()),
+            HS_STATUS_OK
+        );
+        {
+            let ctx = unsafe { &*out };
+            let handler = ctx.handler().unwrap().unwrap();
+            let retired = handler.life.lock().unwrap().retired.len();
+            assert_eq!(retired, 1, "previous callback root retired, not dropped");
+        }
+        assert_eq!(hs_viewer_request_close(out), HS_STATUS_OK);
+        assert_eq!(hs_viewer_drain(out, 1000), HS_STATUS_OK);
+        // New callback received CLOSING; old root was retired and not invoked.
+        assert_eq!(NEW_CALLS.load(Ordering::SeqCst), 1);
+        assert_eq!(OLD_CALLS.load(Ordering::SeqCst), 0);
+        assert_eq!(hs_engine_ctx_free(out), HS_STATUS_OK);
+    }
